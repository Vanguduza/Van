{
  "schema_version": 1,
  "registry_version": "vtil-0.1",
  "policy_id": "van.trading.task-class-signals.v1",
  "why": "Trading task classes are declared here, in registry JSON, so VTIL reuses DIAL's VEKL classifier code unchanged. DIAL's code-resident rules (Android, web, Supabase) stay harmless: they never fire on trading prose.",
  "precedence": "Additive to DIAL's code-resident prose rules.",
  "surface_signals": {},
  "surface_signal_requires_code_evidence": {
    "classes": []
  },
  "path_signals": {
    "rules": [
      {
        "pattern": "^trading/vati/risk/",
        "classes": [
          "RISK_AUTHORITY"
        ]
      },
      {
        "pattern": "^trading/vati/execution/mt5",
        "classes": [
          "MT5_EXECUTION",
          "VENUE_ADAPTER"
        ]
      },
      {
        "pattern": "^trading/vati/execution/deriv",
        "classes": [
          "DERIV_EXECUTION",
          "VENUE_ADAPTER"
        ]
      },
      {
        "pattern": "^trading/vati/nfp/",
        "classes": [
          "NFP_EVENT_TRADING",
          "MACRO_POINT_IN_TIME"
        ]
      },
      {
        "pattern": "^trading/vati/backtest/",
        "classes": [
          "BACKTEST_VALIDATION",
          "TRADING_KERNEL"
        ]
      },
      {
        "pattern": "^trading/vati/zse/",
        "classes": [
          "ZSE_MARKET_RULES",
          "ZSE_MARKET_DATA"
        ]
      }
    ]
  },
  "test_path_signals": {
    "rules": []
  },
  "contract_signals": {},
  "module_signals": {},
  "blob_stringify_feature_record": false,
  "calibration": {
    "max_feature_fraction": 0.4
  },
  "prose_signals": {
    "rules": [
      {
        "class": "NFP_EVENT_TRADING",
        "pattern": "\\b(nfp|non-?farm|payrolls?|employment situation)\\b"
      },
      {
        "class": "LABOUR_DATA",
        "pattern": "\\b(unemployment|jobless|labou?r market|average hourly earnings)\\b"
      },
      {
        "class": "MACRO_POINT_IN_TIME",
        "pattern": "\\b(point[- ]in[- ]time|vintage|revision|alfred|as[- ]of)\\b"
      },
      {
        "class": "RATES_POLICY",
        "pattern": "\\b(fomc|fed funds|rate (hike|cut|path)|policy rate|yield curve|2y|10y|real yields?)\\b"
      },
      {
        "class": "FOMC_EVENT_TRADING",
        "pattern": "\\bfomc\\b"
      },
      {
        "class": "CENTRAL_BANK_LANGUAGE",
        "pattern": "\\b(statement language|forward guidance|hawkish|dovish|central[- ]bank (speech|communication))\\b"
      },
      {
        "class": "POSITIONING_COT",
        "pattern": "\\b(cot|commitments? of traders|positioning|open interest)\\b"
      },
      {
        "class": "IMPLIED_VOLATILITY",
        "pattern": "\\b(implied vol(atility)?|cvol|vix|skew|term structure|risk reversal|expected move)\\b"
      },
      {
        "class": "INDEX_VOLATILITY_REGIME",
        "pattern": "\\b(vix|es|nq|us500|ustec|index (futures|regime))\\b"
      },
      {
        "class": "GOLD_MACRO",
        "pattern": "\\b(gold|xauusd|gc futures|comex|metals?)\\b"
      },
      {
        "class": "FUTURES_ORDERFLOW_REFERENCE",
        "pattern": "\\b(order ?flow|footprint|dom|depth|mbp|l2|book imbalance|databento)\\b"
      },
      {
        "class": "MARKET_DATA_REFERENCE",
        "pattern": "\\b(market data|reference feed|cross[- ]feed|tick data|ohlc)\\b"
      },
      {
        "class": "MT5_EXECUTION",
        "pattern": "\\b(mt5|metatrader|order_send|order_check|mql5)\\b"
      },
      {
        "class": "SYMBOL_CONTRACT_SYNC",
        "pattern": "\\b(symbol_info|contract size|tick value|volume_step|stops level|freeze level)\\b"
      },
      {
        "class": "DERIV_EXECUTION",
        "pattern": "\\bderiv\\b"
      },
      {
        "class": "DERIV_SYNTHETIC",
        "pattern": "\\b(synthetic index|volatility (10|25|50|75|100)|rise/?fall|multipliers?|accumulators?|turbos?|r_75|crash|boom)\\b"
      },
      {
        "class": "TRADING_KERNEL",
        "pattern": "\\b(nautilus|trading kernel|executionclient|dataclient|tradingnode|backtestnode)\\b"
      },
      {
        "class": "VENUE_ADAPTER",
        "pattern": "\\b(venue adapter|execution adapter|adapter template|instrument provider)\\b"
      },
      {
        "class": "BACKTEST_VALIDATION",
        "pattern": "\\b(backtest|walk[- ]forward|out[- ]of[- ]sample|purged|falsification|deflated sharpe)\\b"
      },
      {
        "class": "INDEPENDENT_REPRODUCTION",
        "pattern": "\\b(lean|quantconnect|independent (reproduction|validation))\\b"
      },
      {
        "class": "RECONCILIATION",
        "pattern": "\\b(reconcil\\w+|orphan position|restart recovery)\\b"
      },
      {
        "class": "RISK_AUTHORITY",
        "pattern": "\\b(risk authority|position siz\\w+|portfolio heat|drawdown governor|kill switch|mandate)\\b"
      },
      {
        "class": "ZSE_MARKET_RULES",
        "pattern": "\\b(zse|zimbabwe stock exchange|vfex|finsec|board lot|circuit breaker|t\\+3)\\b"
      },
      {
        "class": "ZSE_MARKET_DATA",
        "pattern": "\\b(price ?sheet|zse (index|all share|data)|zimbabwe (prices|equities))\\b"
      },
      {
        "class": "ZSE_EXECUTION",
        "pattern": "\\b(zse direct|c-?trade|stockbroker instruction|order ticket|contract note)\\b"
      },
      {
        "class": "ZSE_CORPORATE_ACTIONS",
        "pattern": "\\b(rights issue|dividend (date|declaration)|delist\\w*|migrat\\w+ to vfex|results season)\\b"
      },
      {
        "class": "ZSE_FUNDAMENTALS",
        "pattern": "\\b(annual report|ifrs|financial statements|earnings|book value|valuation)\\b"
      },
      {
        "class": "ZSE_COMPLIANCE",
        "pattern": "\\b(secz|securities act|insider trading|exchange control|foreign ownership|repatriat\\w+)\\b"
      },
      {
        "class": "ZIG_CURRENCY_REGIME",
        "pattern": "\\b(zig|zimbabwe gold|parallel (rate|premium)|interbank rate|devaluation|zwl)\\b"
      },
      {
        "class": "VFEX_MARKET",
        "pattern": "\\b(vfex|victoria falls)\\b"
      },
      {
        "class": "ZIM_MACRO",
        "pattern": "\\b(zimstat|zimbabwe inflation|rbz (rate|policy)|monetary policy statement)\\b"
      }
    ]
  }
}
