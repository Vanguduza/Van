{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:van:ml:1.0:DatasetManifest",
  "title": "DatasetManifest",
  "description": "Proposed VAN interchange contract. Shape validity is not permission, factual evidence or runtime qualification. Cross-record semantic validation and independent trusted receipts are required.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "van-ml/1.0"
    },
    "record_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "authority_effect": {
      "const": "NONE"
    },
    "scope": {
      "type": "object",
      "properties": {
        "project_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "cohort_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "instrument_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "venue_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "environment": {
          "enum": [
            "FIXTURE",
            "RESEARCH",
            "SHADOW",
            "LIVE_ADVISORY"
          ]
        }
      },
      "required": [
        "project_id",
        "cohort_id",
        "instrument_id",
        "venue_id",
        "environment"
      ],
      "additionalProperties": false
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "data_cutoff": {
      "type": "string",
      "format": "date-time"
    },
    "max_input_available_at": {
      "type": "string",
      "format": "date-time"
    },
    "availability_quality": {
      "enum": [
        "OBSERVED",
        "PROVIDER_PUBLISHED",
        "RECONSTRUCTED",
        "MIXED"
      ]
    },
    "universe_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "calendar_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_manifest_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "row_identity_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "row_count": {
      "type": "integer",
      "minimum": 1
    },
    "feature_definition_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "target_spec_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "minItems": 1
    },
    "entitlement_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "minItems": 1
    },
    "consent_scope_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "revision_policy": {
      "enum": [
        "AS_OBSERVED",
        "CORRECTED_RESEARCH_ONLY"
      ]
    },
    "partitions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "artifact_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "media_type": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "artifact_id",
          "sha256",
          "media_type",
          "size_bytes"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "schema_version",
    "record_id",
    "authority_effect",
    "scope",
    "created_at",
    "data_cutoff",
    "max_input_available_at",
    "availability_quality",
    "universe_digest",
    "calendar_digest",
    "source_manifest_digest",
    "row_identity_digest",
    "row_count",
    "feature_definition_digest",
    "target_spec_ids",
    "entitlement_refs",
    "consent_scope_ref",
    "revision_policy",
    "partitions"
  ],
  "additionalProperties": false
}
