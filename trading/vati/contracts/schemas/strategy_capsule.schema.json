{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://van.dial/vati/strategy_capsule.schema.json",
  "title": "StrategyCapsule",
  "description": "Signed, versioned strategy definition and its certification evidence (Rev 2 §21). A capsule not in LIMITED_LIVE/CERTIFIED_LIVE cannot produce a live TradeIntent.",
  "type": "object",
  "additionalProperties": false,
  "required": ["strategy_id", "version", "discipline", "instruments", "horizons", "eligible_regimes", "forbidden_regimes", "required_data_granularity", "required_features", "entry_logic_ref", "invalidation_logic_ref", "stop_model", "target_model", "risk_limits", "execution_model", "event_rules", "training_period", "validation_period", "cost_model_ref", "state", "evidence_refs", "capsule_hash"],
  "properties": {
    "strategy_id": {"type": "string", "pattern": "^[A-Z0-9]+(-[A-Z0-9]+)+$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "discipline": {"type": "string"},
    "instruments": {"type": "array", "items": {"type": "string"}},
    "horizons": {"type": "array", "items": {"type": "string", "enum": ["MICRO", "SCALP", "INTRADAY", "SESSION", "OVERNIGHT", "SWING", "POSITION"]}},
    "eligible_regimes": {"type": "array", "items": {"type": "string"}},
    "forbidden_regimes": {"type": "array", "items": {"type": "string"}},
    "required_data_granularity": {"type": "string", "enum": ["BARS", "TICKS", "L1", "L2", "L3"], "description": "SCALP/MICRO horizons may not certify on BARS (Rev 2 §4.4)."},
    "required_features": {"type": "array", "items": {"type": "string"}},
    "entry_logic_ref": {"type": "string"},
    "invalidation_logic_ref": {"type": "string"},
    "stop_model": {"type": "string"},
    "target_model": {"type": "string"},
    "risk_limits": {"type": "object"},
    "execution_model": {"type": "string"},
    "event_rules": {"type": "object"},
    "event_certified": {"type": "boolean", "default": false},
    "synthetic_only": {"type": "boolean", "default": false, "description": "Deriv synthetic strategies are isolated from real-market macro inputs (Rev 2 §20)."},
    "training_period": {"type": "string"},
    "validation_period": {"type": "string"},
    "cost_model_ref": {"type": "string"},
    "state": {"type": "string", "enum": ["RESEARCH", "BACKTEST", "VALIDATION", "DEMO", "SHADOW", "LIMITED_LIVE", "CERTIFIED_LIVE", "DEGRADED", "SUSPENDED", "RETIRED"]},
    "health_score": {"type": "string"},
    "approved_at_unix": {"type": "integer"},
    "approval_signature_ref": {"type": "string"},
    "evidence_refs": {"type": "array", "items": {"type": "string"}},
    "supersedes": {"type": "string"},
    "capsule_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
