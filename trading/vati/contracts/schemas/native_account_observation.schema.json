{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://van.local/contracts/native_account_observation.schema.json",
  "title": "Read-only native account observation in existing owner account and portfolio responses",
  "description": "Original identity/valuation facts are independent of cash-history coverage. Amount strings are native double text, not settled money. Runtime validates source/snapshot seals, physical profile, chronology and exact credit subtraction; this schema alone grants no execution or native qualification.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "state": {
      "enum": [
        "OBSERVED",
        "UNAVAILABLE",
        "UNMEASURED"
      ]
    },
    "reason": {
      "type": "string",
      "maxLength": 256
    },
    "execution_authority": {
      "const": false
    },
    "schema": {
      "const": "vati.mt5-account-observation/1"
    },
    "provider": {
      "const": "MT5"
    },
    "account_alias": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "server": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "currency": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "source_nonce": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "login": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "demo": {
      "type": "boolean"
    },
    "scope_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_ref": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "snapshot_ref": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_received_at_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "observed_at_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "received_at_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "reported_equity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$"
    },
    "balance": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$"
    },
    "credit": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$"
        },
        {
          "type": "null"
        }
      ]
    },
    "risk_equity": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$"
        },
        {
          "type": "null"
        }
      ]
    },
    "source_kind": {
      "enum": [
        "MT5_SIGNED_MTLS_READ",
        "MT5_SIGNED_EA_POLL"
      ]
    },
    "money_basis": {
      "const": "NATIVE_DOUBLE_TEXT_NOT_SETTLED_MINOR_UNITS"
    },
    "valuation_state": {
      "enum": [
        "CREDIT_EXCLUDED",
        "CREDIT_UNAVAILABLE",
        "CREDIT_LIABILITY_UNQUALIFIED"
      ]
    }
  },
  "required": [
    "state",
    "execution_authority"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "OBSERVED"
          }
        }
      },
      "then": {
        "required": [
          "state",
          "execution_authority",
          "schema",
          "provider",
          "account_alias",
          "server",
          "currency",
          "source_nonce",
          "login",
          "demo",
          "scope_hash",
          "source_ref",
          "snapshot_ref",
          "source_received_at_ms",
          "observed_at_ms",
          "received_at_ms",
          "reported_equity",
          "balance",
          "credit",
          "risk_equity",
          "source_kind",
          "money_basis",
          "valuation_state"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "valuation_state": {
                  "const": "CREDIT_EXCLUDED"
                }
              }
            },
            "then": {
              "properties": {
                "credit": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$"
                },
                "risk_equity": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024,
                  "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "valuation_state": {
                  "const": "CREDIT_UNAVAILABLE"
                }
              }
            },
            "then": {
              "properties": {
                "credit": {
                  "type": "null"
                },
                "risk_equity": {
                  "type": "null"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "valuation_state": {
                  "const": "CREDIT_LIABILITY_UNQUALIFIED"
                }
              }
            },
            "then": {
              "properties": {
                "credit": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$"
                },
                "risk_equity": {
                  "type": "null"
                }
              }
            }
          }
        ]
      },
      "else": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "state": {
            "enum": [
              "OBSERVED",
              "UNAVAILABLE",
              "UNMEASURED"
            ]
          },
          "reason": {
            "type": "string",
            "maxLength": 256
          },
          "execution_authority": {
            "const": false
          }
        }
      }
    }
  ]
}
