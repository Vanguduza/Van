{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://van.dial/vati/symbol_contract.schema.json",
  "title": "SymbolContract",
  "description": "Venue-truth symbol specification captured from the adapter's symbol sync (Rev 2 \u00a75.2). Nothing here may be assumed; every value is read from the venue and hashed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "symbol",
    "venue",
    "base_currency",
    "quote_currency",
    "account_currency",
    "contract_size",
    "tick_size",
    "tick_value",
    "volume_min",
    "volume_step",
    "volume_max",
    "min_stop_distance",
    "trade_mode",
    "loss_model",
    "synced_at_unix",
    "spec_hash"
  ],
  "properties": {
    "symbol": {
      "type": "string"
    },
    "venue": {
      "type": "string",
      "enum": [
        "mt5",
        "deriv",
        "ctrader",
        "zse",
        "vfex"
      ]
    },
    "broker_symbol_alias": {
      "type": "string",
      "description": "Raw broker symbol (e.g. EURUSD.m); canonical symbol is normalised centrally."
    },
    "base_currency": {
      "type": "string"
    },
    "quote_currency": {
      "type": "string"
    },
    "account_currency": {
      "type": "string"
    },
    "contract_size": {
      "type": "string"
    },
    "tick_size": {
      "type": "string"
    },
    "tick_value": {
      "type": "string",
      "description": "Account currency per lot per tick, at sync time."
    },
    "volume_min": {
      "type": "string"
    },
    "volume_step": {
      "type": "string"
    },
    "volume_max": {
      "type": "string"
    },
    "min_stop_distance": {
      "type": "string",
      "description": "Price units; adapter folds stops_level, freeze_level and current spread into this."
    },
    "trade_mode": {
      "type": "string",
      "enum": [
        "FULL",
        "LONG_ONLY",
        "SHORT_ONLY",
        "CLOSE_ONLY",
        "DISABLED"
      ]
    },
    "loss_model": {
      "type": "string",
      "enum": [
        "STOP_DISTANCE",
        "FULL_STAKE",
        "ILLIQUID_EQUITY"
      ]
    },
    "max_stake": {
      "type": [
        "string",
        "null"
      ]
    },
    "is_synthetic": {
      "type": "boolean",
      "default": false
    },
    "margin_initial_per_lot": {
      "type": "string"
    },
    "swap_long": {
      "type": "string"
    },
    "swap_short": {
      "type": "string"
    },
    "swap_triple_day": {
      "type": "string",
      "enum": [
        "MON",
        "TUE",
        "WED",
        "THU",
        "FRI",
        "NONE"
      ]
    },
    "filling_modes": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "FOK",
          "IOC",
          "RETURN"
        ]
      }
    },
    "session_calendar_ref": {
      "type": "string"
    },
    "synced_at_unix": {
      "type": "integer"
    },
    "spec_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "board_lot": {
      "type": "string",
      "description": "ILLIQUID_EQUITY: shares per board lot (ZSE: 100)."
    },
    "adv_20d": {
      "type": "string",
      "description": "ILLIQUID_EQUITY: trailing 20-session average daily volume in shares; 0 = unknown = NO_TRADE."
    },
    "max_adv_participation": {
      "type": "string",
      "description": "ILLIQUID_EQUITY: max fraction of ADV one order may take (default 0.10)."
    },
    "liquidity_haircut": {
      "type": "string",
      "description": "ILLIQUID_EQUITY: fraction of price added to the stop distance for gap/impact (vati.zse.liquidity)."
    },
    "round_trip_cost_pct": {
      "type": "string",
      "description": "All-in buy+sell cost as a fraction of notional (vati.zse.costs for ZSE/VFEX; spread+commission+swap model for FX)."
    }
  }
}
