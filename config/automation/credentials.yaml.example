schema_version: 1
credential_aliases: {}
classes:
  C0_OWNER_ROOT:
    n8n_storage: forbidden
  C1_FINANCIAL_EXECUTION:
    n8n_storage: forbidden
  C2_CANONICAL_SERVICE:
    n8n_storage: forbidden
    access: gateway_capability_reference_only
  C3_SENSITIVE_INTEGRATION:
    n8n_storage: explicit_admission_required
  C4_LOW_RISK_INTEGRATION:
    n8n_storage: permitted_after_admission
rules:
  raw_secret_in_workflow_ir: forbidden
  raw_secret_in_compiled_workflow: forbidden
  credential_alias_required: true
