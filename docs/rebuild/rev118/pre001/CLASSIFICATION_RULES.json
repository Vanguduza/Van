{
 "schema": "van.rebuild.pre001.classification-rules/1",
 "rule": "Ordered; first matching regex (Python re.search against the repository path) wins. Hand-authored judgement by the lead, pending independent review. 'units' names the Rev1.18 plan units that own the file's behaviour or acceptance; 'class' is the migration disposition at PRE stage, before any unit has been implemented. Nothing here asserts that a file satisfies its unit.",
 "kinds": [
  "EXECUTABLE_SOURCE",
  "TEST",
  "TEST_FIXTURE",
  "BUILD_CONFIG",
  "RUNTIME_CONFIG",
  "GENERATED_LOCK",
  "VENDOR",
  "VENDOR_BINARY",
  "ASSET",
  "LICENSE_NOTICE",
  "DOCUMENTATION",
  "AGENT_PROFILE",
  "DEV_PREVIEW_TOOL",
  "TOOLING",
  "DATA_REGISTRY",
  "DEPLOYMENT_SOURCE",
  "GENERATED_SNAPSHOT"
 ],
 "classes": {
  "RETAIN": "Keep unchanged through migration unless its owning unit finds a defect.",
  "ADAPT": "Keep as the migration baseline and modify inside its owning unit; historical defects must be revalidated at the implementation head.",
  "EXTEND": "Keep and add the missing Rev1.18 behaviour in the owning unit.",
  "REPLACE": "A new implementation is required; the current file stays until parity evidence exists.",
  "RETIRE_AFTER_PARITY": "Legacy presentation: retained and working until REL-002 parity and owner-approved retirement; no new feature work before BG-001."
 },
 "rules": [
  {
   "id": "R-ROOT-LICENSE",
   "re": "^LICENSE$",
   "kind": "LICENSE_NOTICE",
   "units": [
    "REL-001"
   ],
   "class": "RETAIN",
   "why": "Repository licence."
  },
  {
