+@pytest.mark.parametrize('key,value',[
+    ('NODE_OPTIONS','--import=data:text/javascript,process.exit(0)'),
+    ('NODE_PATH','/unqualified/module/search'),('NODE_COMPILE_CACHE','/unqualified/shared-cache'),
