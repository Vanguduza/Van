diff --git a/android/app/src/main/java/com/dial/van/gateway/PermissionRevocationOperations.kt b/android/app/src/main/java/com/dial/van/gateway/PermissionRevocationOperations.kt
new file mode 100644
index 00000000..3643b5eb
--- /dev/null
+++ b/android/app/src/main/java/com/dial/van/gateway/PermissionRevocationOperations.kt
@@ -0,0 +1,115 @@
+package com.dial.van.gateway
+
+import org.json.JSONArray
+import org.json.JSONObject
+
+interface PermissionRevocationStore {
+    fun load(): String?
+    fun save(value: String): Boolean
+}
+
+data class PendingPermissionRevocation(val profileId: String, val deviceId: String, val grantId: String, val requestBody: String) {
+    val operationId: String get() = JSONObject(requestBody).getString("operation_id")
+    val sourceDigest: String get() = JSONObject(requestBody).getString("expected_source_digest")
+}
+
+/** LAC-210 original intent and server-owned deadline survive lost replies and process death. */
+class PermissionRevocationOperations(private val store: PermissionRevocationStore) {
+    companion object {
+        private val lock = Any()
+        private val fingerprint = Regex("[0-9a-f]{64}")
+        private val identity = Regex("[A-Za-z0-9][A-Za-z0-9._-]{15,127}")
+        private val requestKeys = setOf("operation_id", "caller_device_id", "grant_device_id", "expected_revision", "expected_source_digest", "request_token")
+    }
+    private fun read(): List<PendingPermissionRevocation> {
+        val raw = store.load() ?: return emptyList()
+        check(raw.length <= 131072) { "permission_revocation_history_unreadable" }
+        val rows = JSONArray(raw)
+        check(rows.length() <= 64) { "permission_revocation_history_unreadable" }
+        val result = (0 until rows.length()).map { index ->
+            val row = rows.getJSONObject(index)
+            check(row.keys().asSequence().toSet() == setOf("profile_id", "device_id", "grant_id", "request_body"))
+            val value = PendingPermissionRevocation(row.getString("profile_id"), row.getString("device_id"), row.getString("grant_id"), row.getString("request_body"))
+            val request = JSONObject(value.requestBody)
+            check(value.profileId.isNotBlank() && value.deviceId.isNotBlank() && value.grantId.isNotBlank())
+            check(request.keys().asSequence().toSet() == requestKeys && identity.matches(value.operationId))
+            check(request.getString("caller_device_id") == value.deviceId && request.getString("request_token").length in 1..16384)
+            check(fingerprint.matches(request.getString("expected_revision")) && fingerprint.matches(value.sourceDigest))
+            value
+        }
+        check(result.map { listOf(it.profileId, it.deviceId, it.grantId, it.sourceDigest) }.toSet().size == result.size)
+        check(result.map { it.operationId }.toSet().size == result.size)
+        return result
+    }
+    private fun write(rows: List<PendingPermissionRevocation>) {
+        val value = JSONArray()
+        rows.forEach { value.put(JSONObject().put("profile_id", it.profileId).put("device_id", it.deviceId).put("grant_id", it.grantId).put("request_body", it.requestBody)) }
+        check(value.toString().length <= 131072 && rows.size <= 64)
+        check(store.save(value.toString())) { "permission_revocation_original_store_failed" }
+    }
+    fun pending(profileId: String, deviceId: String, grantId: String, sourceDigest: String): PendingPermissionRevocation? = synchronized(lock) {
+        read().firstOrNull { it.profileId == profileId && it.deviceId == deviceId && it.grantId == grantId && it.sourceDigest == sourceDigest }
+    }
+    fun prepare(profileId: String, deviceId: String, grantId: String, reviewed: JSONObject): PendingPermissionRevocation = synchronized(lock) {
+        require(profileId.isNotBlank() && deviceId.isNotBlank() && grantId.isNotBlank() && reviewed.getString("grant_id") == grantId)
+        val source = reviewed.getString("source_digest")
+        pending(profileId, deviceId, grantId, source)?.let { return@synchronized it }
+        check(reviewed.getString("caller_device_id") == deviceId) { "permission_caller_changed" }
+        val request = reviewed.optJSONObject("revocation_request") ?: error("permission_revocation_request_unavailable")
+        check(request.keys().asSequence().toSet() == requestKeys && request.getString("caller_device_id") == deviceId)
+        check(request.opt("grant_device_id") == reviewed.opt("grant_device_id"))
+        check(request.getString("expected_revision") == reviewed.getString("source_revision") && request.getString("expected_source_digest") == source)
+        check(identity.matches(request.getString("operation_id")) && request.getString("request_token").length in 1..16384)
+        check(fingerprint.matches(request.getString("expected_revision")) && fingerprint.matches(source))
+        val original = PendingPermissionRevocation(profileId, deviceId, grantId, request.toString())
+        // Another UNKNOWN generation is retained; only an explicit fresh reviewed
+        // selection can prepare this different generation. No old intent is retargeted.
+        write(read() + original)
+        original
+    }
+    fun observe(original: PendingPermissionRevocation, receipt: JSONObject): Boolean = synchronized(lock) {
+        val current = read().firstOrNull { it.operationId == original.operationId }
+        check(current == null || current == original) { "permission_revocation_original_changed" }
+        val request = JSONObject(original.requestBody)
+        check(receipt.getString("operation_id") == original.operationId && receipt.getString("grant_id") == original.grantId &&
+            receipt.getString("caller_device_id") == original.deviceId && receipt.opt("grant_device_id") == request.opt("grant_device_id") &&
+            receipt.getString("expected_revision") == request.getString("expected_revision"))
+        check(receipt.opt("native_authority_issued") == false && receipt.getString("source_digest") == original.sourceDigest)
+        val applied = receipt.getString("state") == "APPLIED"
+        if (applied) {
+            val timestamp = receipt.opt("revoked_at_ms")
+            check(receipt.opt("revoked") == true && (timestamp is Int || timestamp is Long) && (timestamp as Number).toLong() > 0)
+        } else {
+            check(receipt.getString("state") == "REFUSED" && receipt.opt("revoked") == false && receipt.isNull("revoked_at_ms"))
+            check(receipt.getString("reason_code") in setOf("permission_revocation_stale_revision", "permission_revocation_request_expired", "permission_revocation_caller_changed"))
+        }
+        if (current != null) write(read().filterNot { it.operationId == original.operationId })
+        applied
+    }
+    /** Real app HTTP adapters use this same persisted exchange tested by the JVM harness. */
+    fun revoke(profileId: String, deviceId: String, grantId: String, reviewed: JSONObject,
+               currentProfile: () -> String, currentDevice: () -> String?, detail: () -> JSONObject,
+               originalResult: (PendingPermissionRevocation) -> JSONObject?, submit: (PendingPermissionRevocation) -> Unit): JSONObject {
+        fun currentOwner() = check(currentDevice() == deviceId && currentProfile() == profileId) { "permission_caller_changed" }
+        currentOwner()
+        val original = prepare(profileId, deviceId, grantId, reviewed)
+        var observed = originalResult(original)
+        if (observed == null) {
+            currentOwner()
+            try { submit(original) } catch (failure: Throwable) {
+                observed = originalResult(original)
+                if (observed == null) throw failure
+            }
+            if (observed == null) observed = originalResult(original)
+        }
+        val receipt = observed ?: error("permission_revocation_original_unavailable")
+        currentOwner()
+        if (receipt.optString("state") == "APPLIED") {
+            val current = detail()
+            check(current.getString("grant_id") == grantId && current.getLong("revoked_at_ms") == receipt.getLong("revoked_at_ms") &&
+                current.getString("source_digest") == receipt.getString("source_digest") && current.getInt("effective_remaining_uses") == 0)
+        }
+        check(observe(original, receipt)) { receipt.optString("reason_code", "permission_revocation_refused") }
+        return receipt
+    }
+}
diff --git a/android/verification/src/test/kotlin/com/dial/van/gateway/PermissionRevocationOperationsTest.kt b/android/verification/src/test/kotlin/com/dial/van/gateway/PermissionRevocationOperationsTest.kt
new file mode 100644
index 00000000..9626f881
--- /dev/null
+++ b/android/verification/src/test/kotlin/com/dial/van/gateway/PermissionRevocationOperationsTest.kt
@@ -0,0 +1,132 @@
+package com.dial.van.gateway
+
+import org.json.JSONObject
+import java.io.IOException
+import java.util.UUID
+import kotlin.test.*
+
+class PermissionRevocationOperationsTest {
+    private class Store : PermissionRevocationStore {
+        var value: String? = null
+        var writable = true
+        override fun load() = value
+        override fun save(value: String): Boolean { if (!writable) return false; this.value = value; return true }
+    }
+    private fun detail(source: String = "b".repeat(64), issuer: String? = "historic-issuer"): JSONObject {
+        val request = JSONObject().put("operation_id", "permission-revoke-${UUID.randomUUID()}")
+            .put("caller_device_id", "owner-one").put("grant_device_id", issuer ?: JSONObject.NULL)
+            .put("expected_revision", "a".repeat(64)).put("expected_source_digest", source).put("request_token", "opaque-server-sealed-request-fixture")
+        return JSONObject().put("grant_id", "grant-one").put("caller_device_id", "owner-one")
+            .put("grant_device_id", issuer ?: JSONObject.NULL).put("source_revision", "a".repeat(64)).put("source_digest", source)
+            .put("revoked_at_ms", JSONObject.NULL).put("effective_remaining_uses", 3).put("revocation_request", request)
+    }
+    private fun receipt(p: PendingPermissionRevocation, applied: Boolean = true): JSONObject = JSONObject()
+        .put("operation_id", p.operationId).put("grant_id", p.grantId).put("caller_device_id", p.deviceId)
+        .put("grant_device_id", JSONObject(p.requestBody).opt("grant_device_id"))
+        .put("expected_revision", JSONObject(p.requestBody).getString("expected_revision")).put("source_digest", p.sourceDigest)
+        .put("state", if (applied) "APPLIED" else "REFUSED").put("revoked", applied)
+        .put("revoked_at_ms", if (applied) 12345 else JSONObject.NULL).put("native_authority_issued", false)
+        .put("reason_code", if (applied) JSONObject.NULL else "permission_revocation_request_expired")
+    @Test fun `original body deadline and distinct historic issuer survive process restart`() {
+        val store = Store(); val operations = PermissionRevocationOperations(store)
+        val original = operations.prepare("profile-one", "owner-one", "grant-one", detail())
+        val restarted = PermissionRevocationOperations(store)
+        assertEquals(original, restarted.pending("profile-one", "owner-one", "grant-one", original.sourceDigest))
+        assertEquals(original, restarted.prepare("profile-one", "owner-one", "grant-one", detail()))
+        assertNull(restarted.pending("other-profile", "owner-one", "grant-one", original.sourceDigest))
+        assertNull(restarted.pending("profile-one", "other-owner", "grant-one", original.sourceDigest))
+        assertTrue(restarted.observe(original, receipt(original)))
+        assertTrue(restarted.observe(original, receipt(original)))
+    }
+    @Test fun `only explicit different reviewed generation creates fresh intent and old unknown is retained`() {
+        val store = Store(); val operations = PermissionRevocationOperations(store)
+        val old = operations.prepare("profile-one", "owner-one", "grant-one", detail())
+        val fresh = operations.prepare("profile-one", "owner-one", "grant-one", detail(source = "c".repeat(64)))
+        assertNotEquals(old.operationId, fresh.operationId)
+        assertEquals(old, operations.pending("profile-one", "owner-one", "grant-one", old.sourceDigest))
+        assertTrue(operations.observe(fresh, receipt(fresh)))
+        assertEquals(old, operations.pending("profile-one", "owner-one", "grant-one", old.sourceDigest))
+    }
+    @Test fun `wrong scope unknown and malformed receipt cannot discard original`() {
+        val store = Store(); val operations = PermissionRevocationOperations(store)
+        val original = operations.prepare("profile-one", "owner-one", "grant-one", detail())
+        for (changed in listOf(receipt(original).put("caller_device_id", "other-owner"),receipt(original).put("grant_device_id", "other-issuer"),
+            receipt(original).put("grant_id", "other-grant"),receipt(original).put("operation_id", "other-operation-123456"),
+            receipt(original).put("source_digest", "c".repeat(64)),receipt(original).put("state", "UNKNOWN"),
+            receipt(original).put("revoked_at_ms", "12345"),receipt(original).put("revoked_at_ms", 12345.0))) {
+            assertFails { operations.observe(original, changed) }
+            assertEquals(original, operations.pending("profile-one", "owner-one", "grant-one", original.sourceDigest))
+        }
+    }
+    @Test fun `save failure precedes network and failed cleanup retains known original`() {
+        val store = Store(); val operations = PermissionRevocationOperations(store)
+        store.writable = false
+        assertFailsWith<IllegalStateException> { operations.prepare("profile-one", "owner-one", "grant-one", detail()) }
+        assertNull(store.value)
+        store.writable = true
+        val original = operations.prepare("profile-one", "owner-one", "grant-one", detail())
+        store.writable = false
+        assertFails { operations.observe(original, receipt(original)) }
+        assertEquals(original, operations.pending("profile-one", "owner-one", "grant-one", original.sourceDigest))
+    }
+    @Test fun `terminal refusal does not clear later explicit operation`() {
+        val store = Store(); val operations = PermissionRevocationOperations(store)
+        val old = operations.prepare("profile-one", "owner-one", "grant-one", detail())
+        assertFalse(operations.observe(old, receipt(old, false)))
+        val fresh = operations.prepare("profile-one", "owner-one", "grant-one", detail())
+        assertNotEquals(old.operationId, fresh.operationId)
+        assertFalse(operations.observe(old, receipt(old, false)))
+        assertEquals(fresh, operations.pending("profile-one", "owner-one", "grant-one", fresh.sourceDigest))
+    }
+    @Test fun `actual caller exchange recovers lost commit response with one effect and independent detail`() {
+        val store = Store(); val operations = PermissionRevocationOperations(store)
+        val review = detail(); var current = review; var completed: JSONObject? = null; var submits = 0
+        val result = operations.revoke("profile-one", "owner-one", "grant-one", review,
+            currentProfile = { "profile-one" }, currentDevice = { "owner-one" }, detail = { current },
+            originalResult = { completed }, submit = { original ->
+                submits++; completed = receipt(original)
+                current = detail().put("revoked_at_ms", 12345).put("effective_remaining_uses", 0)
+                throw IOException("lost response after actual modeled commit")
+            })
+        assertEquals(1, submits); assertEquals("APPLIED", result.getString("state"))
+        assertNull(operations.pending("profile-one", "owner-one", "grant-one", review.getString("source_digest")))
+    }
+    @Test fun `unavailable readback keeps original and restart never resubmits applied effect`() {
+        val store = Store(); val review = detail(); var completed: JSONObject? = null; var reads = 0; var submits = 0
+        assertFailsWith<IOException> {
+            PermissionRevocationOperations(store).revoke("profile-one", "owner-one", "grant-one", review,
+                currentProfile = { "profile-one" },currentDevice = { "owner-one" },detail = { error("unavailable") },
+                originalResult = { if (++reads == 1) null else throw IOException("readback unavailable") },submit = { original ->
+                    submits++; completed = receipt(original); throw IOException("reply lost")
+                })
+        }
+        val restarted = PermissionRevocationOperations(store)
+        assertNotNull(restarted.pending("profile-one", "owner-one", "grant-one", review.getString("source_digest")))
+        val result = restarted.revoke("profile-one", "owner-one", "grant-one", detail(),
+            currentProfile = { "profile-one" },currentDevice = { "owner-one" },
+            detail = { detail().put("revoked_at_ms", 12345).put("effective_remaining_uses", 0) },
+            originalResult = { completed },submit = { error("applied effect must not be resubmitted") })
+        assertEquals(1, submits); assertEquals("APPLIED", result.getString("state"))
+    }
+    @Test fun `profile or caller switch prevents any original lookup or mutation`() {
+        for (switched in listOf("profile", "caller")) {
+            val operations = PermissionRevocationOperations(Store())
+            assertFails {
+                operations.revoke("profile-one", "owner-one", "grant-one", detail(),
+                    currentProfile = { if (switched == "profile") "other-profile" else "profile-one" },
+                    currentDevice = { if (switched == "caller") "other-owner" else "owner-one" },
+                    detail = { error("no read") },originalResult = { error("no original lookup") },submit = { error("no mutation") })
+            }
+        }
+    }
+    @Test fun `unverified local target can be withdrawn without claiming a historic issuer`() {
+        val operations = PermissionRevocationOperations(Store())
+        val original = operations.prepare("profile-one", "owner-one", "grant-one", detail(issuer = null))
+        assertTrue(operations.observe(original, receipt(original)))
+    }
+    @Test fun `corrupt history never starts a replacement operation`() {
+        val store = Store(); store.value = "[{broken]"
+        assertFails { PermissionRevocationOperations(store).prepare("profile-one", "owner-one", "grant-one", detail()) }
+        assertEquals("[{broken]", store.value)
+    }
