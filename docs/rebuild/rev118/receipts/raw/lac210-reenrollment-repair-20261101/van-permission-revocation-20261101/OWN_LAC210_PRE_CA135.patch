+    result['source_revision']=digest({'source':result['source_digest'],'use_count':row['use_count'],
+        'last_used_at_ms':row['last_used_at_ms'],'revoked_at_ms':row['revoked_at_ms'],
+        'revocation_reason':row['revocation_reason'],'state':state})
+    result['observed_at_ms']=now
+    return result
