+async def owner_grant_detail(store,grant_id,*,device_id=None):
+    async with store.connection() as db:
+        await db.execute('BEGIN')
+        return await grant_detail_in_snapshot(db,grant_id,device_id=device_id)
+
+async def _revocation_actor(db,device_id):
+    from van_gateway.capability.permissions import PermissionError_
+    row=await (await db.execute('SELECT revoked_at_unix FROM devices WHERE device_id=?',(device_id,))).fetchone()
+    if not row or row['revoked_at_unix'] is not None:
+        raise PermissionError_('permission_device_revoked')
+
+async def _original_revocation(db, *, operation_id, grant_id, device_id, cipher):
+    from cryptography.fernet import InvalidToken
+    from van_gateway.capability.permissions import PermissionError_
+    row=await (await db.execute('SELECT value FROM runtime_meta WHERE key=?',(REVOCATION_PREFIX+operation_id,))).fetchone()
+    if row is None:return None
+    try:
+        record=json.loads(cipher.decrypt(row['value'].encode()))
+        if set(record)!={'schema','request','request_digest','source_digest','result'} or record['schema']!=REVOCATION_SCHEMA:
+            raise ValueError('invalid original schema')
+        request=record['request'];result=record['result']
+        if (set(request)!={'operation_id','grant_id','device_id','expected_revision','expected_source_digest'}
+            or digest(request)!=record['request_digest'] or request['operation_id']!=operation_id
+            or set(result)!={'operation_id','grant_id','device_id','state','revoked','revoked_at_ms','source_digest','effect_scope','native_authority_issued','expected_revision','reason_code'}
+            or result['operation_id']!=operation_id or result['grant_id']!=request['grant_id']
+            or result['device_id']!=request['device_id'] or result['state'] not in {'APPLIED','REFUSED'}
+            or result['native_authority_issued'] is not False
+            or (result['state']=='APPLIED' and (result['revoked'] is not True or type(result['revoked_at_ms']) is not int or result['revoked_at_ms']<=0 or result['reason_code'] is not None))
+            or (result['state']=='REFUSED' and (result['revoked'] is not False or result['revoked_at_ms'] is not None or result['reason_code'] not in {'permission_revocation_stale_revision','permission_grant_expired'}))
+            or result['source_digest']!=record['source_digest'] or result['expected_revision']!=request['expected_revision']):
+            raise ValueError('invalid original binding')
+    except (InvalidToken,ValueError,TypeError,KeyError,AttributeError):
+        raise PermissionError_('permission_revocation_history_unavailable') from None
+    if request['device_id']!=device_id:raise PermissionError_('permission_device_mismatch')
+    if request['grant_id']!=grant_id:raise PermissionError_('permission_revocation_operation_conflict')
+    if result['state']=='REFUSED':return record
+    detail=await grant_detail_in_snapshot(db,grant_id,device_id=device_id)
+    if detail['source_digest']!=record['source_digest'] or detail['revoked_at_ms']!=result['revoked_at_ms'] or detail['revocation_reason']!='owner revoked':
+        raise PermissionError_('permission_revocation_subject_changed')
+    if detail['effect_scope']!=result['effect_scope']:
+        raise PermissionError_('permission_revocation_subject_changed')
+    return record
+
+async def revoke_permission_grant(store,*,grant_id,device_id,cipher,operation_id=None,expected_revision=None,expected_source_digest=None):
+    from van_gateway.capability.permissions import PermissionError_
+    import re
+    legacy=operation_id is None
+    if legacy:
+        if expected_revision is not None or expected_source_digest is not None:
+            raise PermissionError_('permission_revocation_identity_required')
+        operation_id='legacy-'+digest({'grant_id':grant_id,'device_id':device_id})
+    elif (not isinstance(operation_id,str) or not re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9._-]{15,127}',operation_id)
+          or not isinstance(expected_revision,str) or not re.fullmatch(r'[0-9a-f]{64}',expected_revision)
+          or not isinstance(expected_source_digest,str) or not re.fullmatch(r'[0-9a-f]{64}',expected_source_digest)):
+        raise PermissionError_('permission_revocation_precondition_required')
+    request=dict(operation_id=operation_id,grant_id=grant_id,device_id=device_id,
+        expected_revision=expected_revision,expected_source_digest=expected_source_digest)
+    async with store.connection() as db:
+        await db.execute('BEGIN IMMEDIATE')
+        await _revocation_actor(db,device_id)
+        original=await _original_revocation(db,operation_id=operation_id,grant_id=grant_id,device_id=device_id,cipher=cipher)
+        if original is not None:
+            if digest(request)!=original['request_digest']:
+                raise PermissionError_('permission_revocation_operation_conflict')
+            return original['result']
+        detail=await grant_detail_in_snapshot(db,grant_id,device_id=device_id)
+        if not legacy and detail['source_digest']!=expected_source_digest:
+            raise PermissionError_('permission_revocation_subject_changed')
+        if detail['revoked_at_ms'] is not None:
+            raise PermissionError_('permission_revocation_original_identity_required')
+        # Expired authenticated consent cannot be presented as fresh current authority.
+        # Local-only legacy registry cleanup remains available under existing owner auth.
+        now=int(time.time()*1000)
+        refusal=('permission_revocation_stale_revision' if not legacy and detail['source_revision']!=expected_revision else
+                 'permission_grant_expired' if detail['source_verified'] and detail['expires_at_ms']<=now else None)
+        result=dict(operation_id=operation_id,grant_id=grant_id,device_id=device_id,state='APPLIED',
+            revoked=True,revoked_at_ms=now,source_digest=detail['source_digest'],expected_revision=expected_revision,
+            effect_scope=detail['effect_scope'],native_authority_issued=False,reason_code=None)
+        if refusal is None:
+            changed=await db.execute("UPDATE permission_grants SET revoked_at_ms=?,revocation_reason='owner revoked' "
+                "WHERE grant_id=? AND revoked_at_ms IS NULL AND (?=0 OR expires_at_ms>CAST((julianday('now')-2440587.5)*86400000 AS INTEGER))",
+                (now,grant_id,int(detail['source_verified'])))
+            if changed.rowcount!=1:refusal='permission_grant_expired'
+        if refusal is not None:
+            result.update(state='REFUSED',revoked=False,revoked_at_ms=None,reason_code=refusal)
+        record=dict(schema=REVOCATION_SCHEMA,request=request,request_digest=digest(request),source_digest=detail['source_digest'],result=result)
+        await db.execute('INSERT INTO runtime_meta(key,value,updated_at_unix_ms) VALUES(?,?,?)',
+            (REVOCATION_PREFIX+operation_id,cipher.encrypt(Store.dumps(record).encode()).decode(),now))
+        await db.commit()
+        return result
+
+async def original_permission_revocation(store,*,operation_id,grant_id,device_id,cipher):
+    from van_gateway.capability.permissions import PermissionError_
+    async with store.connection() as db:
+        await db.execute('BEGIN')
+        await _revocation_actor(db,device_id)
+        record=await _original_revocation(db,operation_id=operation_id,grant_id=grant_id,device_id=device_id,cipher=cipher)
+        if record is None:raise PermissionError_('permission_revocation_unknown')
+        return record['result']
