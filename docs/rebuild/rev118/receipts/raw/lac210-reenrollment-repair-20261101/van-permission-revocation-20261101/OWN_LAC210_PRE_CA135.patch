+async def grant_detail_in_snapshot(db, grant_id: str, *, device_id: str | None = None, now_ms=None):
+    from van_gateway.capability.permissions import PermissionError_
+    row = await (await db.execute('SELECT * FROM permission_grants WHERE grant_id=?',(grant_id,))).fetchone()
+    if row is None:
+        raise PermissionError_('permission_grant_not_found')
+    result=dict(row)
+    immutable={k:result[k] for k in ('grant_id','permission','display_name','scope','origin','origin_evidence_ref','granted_at_ms','expires_at_ms')}
+    witness=None
+    bound=False
+    current_matches=False
+    now=int(time.time()*1000) if now_ms is None else now_ms
+    if str(row['origin_evidence_ref'] or '').startswith('owner-permission://'):
+        command_id=str(row['origin_evidence_ref'])[len('owner-permission://'):]
+        witness=await _meta(db,WITNESS_PREFIX+command_id)
+        try:
+            params=permission_parameters(json.loads(row['scope']))
+            bound=await _source_bound(db,witness,row,params)
+        except (ValueError,TypeError,KeyError):
+            bound=False
+        if not bound:
+            raise PermissionError_('permission_scope_integrity_failed')
+        if device_id is not None and witness['device_id']!=device_id:
+            raise PermissionError_('permission_device_mismatch')
+        current=await _meta(db,scope_key(params['action_id'],params['parameters']))
+        current_matches=isinstance(current,dict) and digest(current)==digest(witness)
+        issuer=await (await db.execute('SELECT revoked_at_unix FROM devices WHERE device_id=?',(witness['device_id'],))).fetchone()
+        definition=await (await db.execute('SELECT enabled,action_class FROM action_definitions WHERE action_id=?',(params['action_id'],))).fetchone()
+        available=bool(definition and definition['enabled'] and definition['action_class']!='A5')
+        remaining=max(0,params['max_uses']-row['use_count'])
+        live=bool(row['revoked_at_ms'] is None and row['expires_at_ms']>now and issuer and issuer['revoked_at_unix'] is None)
+        current_live=bool(live and current_matches and available and remaining>0)
+        result.update(exact_scope=params,device_id=witness['device_id'],max_uses=params['max_uses'],
+            remaining_uses=remaining,effective_remaining_uses=remaining if current_live else 0,
+            grant_current=current_live,native_authority_required=True,
+            fresh_native_approval_per_use=not definition or definition['action_class']=='A4',
+            use_count_semantics=USE_COUNT_SEMANTICS,source_verified=True,
+            effect_scope='EXACT_OWNER_CONSENT_WITH_INDEPENDENT_NATIVE_AUTHORITY')
+        state=('REVOKED' if row['revoked_at_ms'] is not None else 'EXPIRED' if row['expires_at_ms']<=now else
+            'ISSUER_REVOKED' if not issuer or issuer['revoked_at_unix'] is not None else
+            'SUPERSEDED' if not current_matches else 'UNAVAILABLE' if not available else 'EXHAUSTED' if remaining==0 else 'CURRENT')
+    else:
+        # Preserve legacy owner-registry visibility, without upgrading a metadata row
+        # to authenticated provider/native consent or inferring who issued it.
+        state='REVOKED' if row['revoked_at_ms'] is not None else 'EXPIRED' if row['expires_at_ms'] is not None and row['expires_at_ms']<=now else 'SOURCE_UNVERIFIED'
+        result.update(source_verified=False,device_id=None,max_uses=None,remaining_uses=None,
+            effective_remaining_uses=0,grant_current=False,native_authority_required=True,
