     suspend fun revokePermission(grantId: String): JSONObject = withContext(Dispatchers.IO) {
-        postJson("/v1/permissions/${encodeSegment(grantId)}/revoke", JSONObject())
+        val owner = deviceId ?: error("permission_owner_device_required")
+        val original = permissionRevocations.pending(owner, grantId) ?: permissionRevocations.prepare(
+            owner, grantId, permissionGrant(grantId))
+        val resultPath = "/v1/permissions/${encodeSegment(grantId)}/revocations/${encodeSegment(original.operationId)}"
+        fun readOriginal(): JSONObject? = try { getJson(resultPath) } catch (failure: GatewayHttpException) {
+            if (failure.code == 404) null else throw failure
+        }
+        var observed = readOriginal()
+        if (observed == null) {
+            check(deviceId == owner) { "permission_owner_device_changed" }
+            try {
+                postProved("/v1/permissions/${encodeSegment(grantId)}/revoke", JSONObject(original.requestBody))
+            } catch (failure: Throwable) {
+                // A lost reply or terminal refusal is reconciled using the same persisted
+                // operation. Unknown/unreadable outcomes keep the original intent.
+                observed = readOriginal()
+                if (observed == null) throw failure
+            }
+            if (observed == null) observed = readOriginal()
+        }
+        val receipt = observed ?: error("permission_revocation_original_unavailable")
+        check(deviceId == owner) { "permission_owner_device_changed" }
+        val applied = receipt.optString("state") == "APPLIED"
+        if (applied) {
+            val current = permissionGrant(grantId)
+            check(current.getString("grant_id") == grantId && current.getLong("revoked_at_ms") == receipt.getLong("revoked_at_ms") &&
+                current.getString("source_digest") == receipt.getString("source_digest") && current.getInt("effective_remaining_uses") == 0)
+        }
+        check(permissionRevocations.observe(original, receipt)) { receipt.optString("reason_code", "permission_revocation_refused") }
+        receipt
     }
 
     suspend fun autonomy(): JSONObject = withContext(Dispatchers.IO) { getJson("/v1/autonomy") }
