+    def opened():
+        nonlocal lost
+        kind,make,ledger=open_original();atomic=ledger.atomic
+        @contextmanager
+        def ack():
+            nonlocal lost
+            outer=not ledger._conn.in_transaction
+            with atomic() as tx:yield tx
+            if outer and not lost and ledger.count(EventKind.FUNDING_OWNER_CLASSIFICATION):
