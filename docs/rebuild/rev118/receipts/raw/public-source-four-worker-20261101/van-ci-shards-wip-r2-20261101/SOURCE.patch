+    monkeypatch.setenv("GITHUB_RUN_ID", CONTEXT["id"])
+    monkeypatch.setenv("GITHUB_RUN_ATTEMPT", CONTEXT["attempt"])
+    monkeypatch.setattr(proof, "source_identity", lambda root, expected: {"commit": HEAD, "tree": "b"*40})
