{
  "$id": "urn:van:hva:ExecutableQuoteFacts:1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Proposed Rev1.12 application contract. Examples and schema checks are documentary only; no implementation/permission implied.",
  "properties": {
    "asset_id": {
      "minLength": 1,
      "type": "string"
    },
    "available_at": {
      "format": "date-time",
      "type": "string"
    },
    "cash_currency": {
      "minLength": 1,
      "type": "string"
    },
    "decision_cutoff": {
      "format": "date-time",
      "type": "string"
    },
    "expires_at": {
      "format": "date-time",
      "type": "string"
    },
    "implementation_evidence_level": {
      "enum": [
        "SPEC_ONLY",
        "E0_OWNER_REFERENCE",
        "E1_DOCUMENTED",
        "E2_SOURCE_STATIC",
        "E3_TEST_RECEIPT",
        "E4_RUNTIME_OBSERVED",
        "E5_DEVICE_CERTIFIED",
        "E6_OWNER_VISUALLY_ACCEPTED"
      ]
    },
    "included_cost_components": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 0,
      "type": "array",
      "uniqueItems": true
    },
    "observed_cash_amount": {
      "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
      "type": "string"
    },
    "payload_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "pool_id": {
      "minLength": 1,
      "type": "string"
    },
    "price_convention": {
      "enum": [
        "TOTAL_CASH_FOR_REQUESTED_SIZE"
      ]
    },
    "quantity": {
      "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
      "type": "string"
    },
    "quantity_unit": {
      "minLength": 1,
      "type": "string"
    },
    "quote_id": {
      "minLength": 1,
      "type": "string"
    },
    "quote_status": {
      "enum": [
        "CURRENT",
        "STALE",
        "UNAVAILABLE"
      ]
    },
    "reality": {
      "enum": [
        "SYNTHETIC",
        "OBSERVED",
        "MODELED",
        "DERIVED"
      ]
    },
    "record_id": {
      "minLength": 1,
      "type": "string"
    },
    "research_source_class": {
      "enum": [
        "RS1_PRIMARY",
        "RS2_REPEATABLE_RESEARCH",
        "RS3_VENDOR_CAPABILITY",
        "RS4_SELF_REPORTED",
        "RS5_UNVERIFIED_CREATOR",
        "SYNTHETIC",
        "NOT_APPLICABLE"
      ]
    },
    "router_id": {
      "minLength": 1,
      "type": "string"
    },
    "schema_version": {
      "const": "1.0"
    },
    "side": {
      "enum": [
        "BUY",
        "SELL"
      ]
    },
    "source_refs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "state_anchor": {
      "additionalProperties": false,
      "properties": {
        "chain_id": {
          "minLength": 1,
          "type": "string"
        },
        "finality": {
          "enum": [
            "FINALIZED",
            "CONFIRMED",
            "UNFINALIZED",
            "UNKNOWN"
          ]
        },
        "hash": {
          "minLength": 1,
          "type": "string"
        },
        "height": {
          "minimum": 0,
          "type": "integer"
        },
        "state_epoch": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "chain_id",
        "height",
        "hash",
        "finality",
        "state_epoch"
      ],
      "type": "object"
    },
    "trade_authorized": {
      "const": false
    },
    "venue": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "record_id",
    "reality",
    "research_source_class",
    "implementation_evidence_level",
    "available_at",
    "decision_cutoff",
    "expires_at",
    "source_refs",
    "trade_authorized",
    "quote_id",
    "asset_id",
    "venue",
    "pool_id",
    "router_id",
    "state_anchor",
    "side",
    "quantity",
    "quantity_unit",
    "cash_currency",
    "observed_cash_amount",
    "price_convention",
    "included_cost_components",
    "quote_status",
    "payload_sha256"
  ],
  "title": "ExecutableQuoteFacts",
  "type": "object"
}
