{
  "$id": "urn:van:hva:MatchedOpportunityExperiment:1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Proposed Rev1.12 application contract. Examples and schema checks are documentary only; no implementation/permission implied.",
  "properties": {
    "automatic_promotion": {
      "const": false
    },
    "available_at": {
      "format": "date-time",
      "type": "string"
    },
    "challenger_policy_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "changes_trade_path": {
      "type": "boolean"
    },
    "cohort_manifest_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "control_policy_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "counterfactual_basis": {
      "enum": [
        "WHOLE_POLICY",
        "SIZE_ONLY_BASELINE_R"
      ]
    },
    "decision_at": {
      "format": "date-time",
      "type": "string"
    },
    "decision_cutoff": {
      "format": "date-time",
      "type": "string"
    },
    "discovered_count": {
      "minimum": 1,
      "type": "integer"
    },
    "experiment_id": {
      "minLength": 1,
      "type": "string"
    },
    "expires_at": {
      "format": "date-time",
      "type": "string"
    },
    "fill_model_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "hypothesis_id": {
      "minLength": 1,
      "type": "string"
    },
    "implementation_evidence_level": {
      "enum": [
        "SPEC_ONLY",
        "E0_OWNER_REFERENCE",
        "E1_DOCUMENTED",
        "E2_SOURCE_STATIC",
        "E3_TEST_RECEIPT",
        "E4_RUNTIME_OBSERVED",
        "E5_DEVICE_CERTIFIED",
        "E6_OWNER_VISUALLY_ACCEPTED"
      ]
    },
    "included_count": {
      "minimum": 1,
      "type": "integer"
    },
    "independent_cash_replay": {
      "const": true
    },
    "missing_count": {
      "minimum": 0,
      "type": "integer"
    },
    "outcome_available_at": {
      "format": "date-time",
      "type": "string"
    },
    "reality": {
      "enum": [
        "SYNTHETIC",
        "OBSERVED",
        "MODELED",
        "DERIVED"
      ]
    },
    "record_id": {
      "minLength": 1,
      "type": "string"
    },
    "rejected_count": {
      "minimum": 0,
      "type": "integer"
    },
    "resampling_unit": {
      "enum": [
        "EVENT_TIME_ASSET_CLUSTER"
      ]
    },
    "research_source_class": {
      "enum": [
        "RS1_PRIMARY",
        "RS2_REPEATABLE_RESEARCH",
        "RS3_VENDOR_CAPABILITY",
        "RS4_SELF_REPORTED",
        "RS5_UNVERIFIED_CREATOR",
        "SYNTHETIC",
        "NOT_APPLICABLE"
      ]
    },
    "result_label": {
      "enum": [
        "SIMULATED_COUNTERFACTUAL",
        "FORWARD_PAPER_OBSERVED",
        "REALIZED_VENUE_OBSERVED",
        "INCONCLUSIVE"
      ]
    },
    "schema_version": {
      "const": "1.0"
    },
    "sealed_at": {
      "format": "date-time",
      "type": "string"
    },
    "source_refs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "trade_authorized": {
      "const": false
    },
    "validation_policy_id": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "record_id",
    "reality",
    "research_source_class",
    "implementation_evidence_level",
    "available_at",
    "decision_cutoff",
    "expires_at",
    "source_refs",
    "trade_authorized",
    "experiment_id",
    "hypothesis_id",
    "cohort_manifest_hash",
    "sealed_at",
    "decision_at",
    "outcome_available_at",
    "control_policy_hash",
    "challenger_policy_hash",
    "fill_model_hash",
    "validation_policy_id",
    "discovered_count",
    "included_count",
    "rejected_count",
    "missing_count",
    "result_label",
    "independent_cash_replay",
    "counterfactual_basis",
    "changes_trade_path",
    "resampling_unit",
    "automatic_promotion"
  ],
  "title": "MatchedOpportunityExperiment",
  "type": "object"
}
