{
  "$id": "urn:van:hva:NetEdgeAssessment:1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Proposed Rev1.12 application contract. Examples and schema checks are documentary only; no implementation/permission implied.",
  "properties": {
    "asset_id": {
      "minLength": 1,
      "type": "string"
    },
    "available_at": {
      "format": "date-time",
      "type": "string"
    },
    "cash_currency": {
      "minLength": 1,
      "type": "string"
    },
    "decision_cutoff": {
      "format": "date-time",
      "type": "string"
    },
    "economic_materiality_floor": {
      "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
      "type": "string"
    },
    "economic_state": {
      "enum": [
        "RESEARCH_ONLY",
        "INCONCLUSIVE",
        "REJECTED",
        "ELIGIBLE_FOR_SCOPED_REVIEW"
      ]
    },
    "entry_cash_cost": {
      "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
      "type": "string"
    },
    "existing_risk_authority_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "expected_exit_proceeds": {
      "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
      "type": "string"
    },
    "expires_at": {
      "format": "date-time",
      "type": "string"
    },
    "failure_cost": {
      "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
      "type": "string"
    },
    "forecast_ref": {
      "minLength": 1,
      "type": "string"
    },
    "implementation_evidence_level": {
      "enum": [
        "SPEC_ONLY",
        "E0_OWNER_REFERENCE",
        "E1_DOCUMENTED",
        "E2_SOURCE_STATIC",
        "E3_TEST_RECEIPT",
        "E4_RUNTIME_OBSERVED",
        "E5_DEVICE_CERTIFIED",
        "E6_OWNER_VISUALLY_ACCEPTED"
      ]
    },
    "incremental_exit_costs": {
      "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
      "type": "string"
    },
    "net_ev": {
      "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
      "type": "string"
    },
    "own_sizing_permission": {
      "const": false
    },
    "quantity": {
      "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
      "type": "string"
    },
    "quantity_unit": {
      "minLength": 1,
      "type": "string"
    },
    "quote_ref": {
      "minLength": 1,
      "type": "string"
    },
    "reality": {
      "enum": [
        "SYNTHETIC",
        "OBSERVED",
        "MODELED",
        "DERIVED"
      ]
    },
    "record_id": {
      "minLength": 1,
      "type": "string"
    },
    "research_source_class": {
      "enum": [
        "RS1_PRIMARY",
        "RS2_REPEATABLE_RESEARCH",
        "RS3_VENDOR_CAPABILITY",
        "RS4_SELF_REPORTED",
        "RS5_UNVERIFIED_CREATOR",
        "SYNTHETIC",
        "NOT_APPLICABLE"
      ]
    },
    "schema_version": {
      "const": "1.0"
    },
    "source_refs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "trade_authorized": {
      "const": false
    }
  },
  "required": [
    "schema_version",
    "record_id",
    "reality",
    "research_source_class",
    "implementation_evidence_level",
    "available_at",
    "decision_cutoff",
    "expires_at",
    "source_refs",
    "trade_authorized",
    "quote_ref",
    "forecast_ref",
    "asset_id",
    "quantity",
    "quantity_unit",
    "cash_currency",
    "entry_cash_cost",
    "expected_exit_proceeds",
    "incremental_exit_costs",
    "failure_cost",
    "net_ev",
    "economic_materiality_floor",
    "economic_state",
    "existing_risk_authority_ref",
    "own_sizing_permission"
  ],
  "title": "NetEdgeAssessment",
  "type": "object"
}
