{
  "$id": "urn:van:hva:WalletAttributionSnapshot:1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Proposed Rev1.12 application contract. Examples and schema checks are documentary only; no implementation/permission implied.",
  "properties": {
    "adjusted_holdings_total": {
      "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
      "type": "string"
    },
    "asset_id": {
      "minLength": 1,
      "type": "string"
    },
    "attribution_version": {
      "minLength": 1,
      "type": "string"
    },
    "available_at": {
      "format": "date-time",
      "type": "string"
    },
    "decision_cutoff": {
      "format": "date-time",
      "type": "string"
    },
    "expires_at": {
      "format": "date-time",
      "type": "string"
    },
    "flow_classification": {
      "enum": [
        "OBSERVED_SWAP",
        "TRANSFER_ONLY",
        "ROUTER_HOP",
        "UNKNOWN"
      ]
    },
    "growth_claim": {
      "type": [
        "string",
        "null"
      ]
    },
    "implementation_evidence_level": {
      "enum": [
        "SPEC_ONLY",
        "E0_OWNER_REFERENCE",
        "E1_DOCUMENTED",
        "E2_SOURCE_STATIC",
        "E3_TEST_RECEIPT",
        "E4_RUNTIME_OBSERVED",
        "E5_DEVICE_CERTIFIED",
        "E6_OWNER_VISUALLY_ACCEPTED"
      ]
    },
    "lookback_complete": {
      "type": "boolean"
    },
    "ownership_confidence": {
      "enum": [
        "SUPPORTED",
        "HEURISTIC",
        "UNKNOWN"
      ]
    },
    "previous_snapshot_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "quantity_unit": {
      "minLength": 1,
      "type": "string"
    },
    "raw_holdings_total": {
      "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
      "type": "string"
    },
    "reality": {
      "enum": [
        "SYNTHETIC",
        "OBSERVED",
        "MODELED",
        "DERIVED"
      ]
    },
    "record_id": {
      "minLength": 1,
      "type": "string"
    },
    "research_source_class": {
      "enum": [
        "RS1_PRIMARY",
        "RS2_REPEATABLE_RESEARCH",
        "RS3_VENDOR_CAPABILITY",
        "RS4_SELF_REPORTED",
        "RS5_UNVERIFIED_CREATOR",
        "SYNTHETIC",
        "NOT_APPLICABLE"
      ]
    },
    "schema_version": {
      "const": "1.0"
    },
    "source_refs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "state_anchor": {
      "additionalProperties": false,
      "properties": {
        "chain_id": {
          "minLength": 1,
          "type": "string"
        },
        "finality": {
          "enum": [
            "FINALIZED",
            "CONFIRMED",
            "UNFINALIZED",
            "UNKNOWN"
          ]
        },
        "hash": {
          "minLength": 1,
          "type": "string"
        },
        "height": {
          "minimum": 0,
          "type": "integer"
        },
        "state_epoch": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "chain_id",
        "height",
        "hash",
        "finality",
        "state_epoch"
      ],
      "type": "object"
    },
    "technical_exclusions": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 0,
      "type": "array",
      "uniqueItems": true
    },
    "trade_authorized": {
      "const": false
    }
  },
  "required": [
    "schema_version",
    "record_id",
    "reality",
    "research_source_class",
    "implementation_evidence_level",
    "available_at",
    "decision_cutoff",
    "expires_at",
    "source_refs",
    "trade_authorized",
    "asset_id",
    "state_anchor",
    "previous_snapshot_ref",
    "lookback_complete",
    "raw_holdings_total",
    "adjusted_holdings_total",
    "quantity_unit",
    "technical_exclusions",
    "attribution_version",
    "ownership_confidence",
    "flow_classification",
    "growth_claim"
  ],
  "title": "WalletAttributionSnapshot",
  "type": "object"
}
