{
  "$id": "urn:van:hva:TypedTradingJudgment:1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Proposed Rev1.12 application contract. Examples and schema checks are documentary only; no implementation/permission implied.",
  "properties": {
    "answers": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "answer": {
            "enum": [
              "YES",
              "NO",
              "UNKNOWN"
            ]
          },
          "answer_quality": {
            "maximum": 1,
            "minimum": 0,
            "type": "number"
          },
          "question_id": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "question_id",
          "answer",
          "answer_quality"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "available_at": {
      "format": "date-time",
      "type": "string"
    },
    "confidence_semantics": {
      "const": "ANSWER_QUALITY_NOT_TRADE_PROBABILITY"
    },
    "decision_cutoff": {
      "format": "date-time",
      "type": "string"
    },
    "expires_at": {
      "format": "date-time",
      "type": "string"
    },
    "hard_filter_override": {
      "const": false
    },
    "implementation_evidence_level": {
      "enum": [
        "SPEC_ONLY",
        "E0_OWNER_REFERENCE",
        "E1_DOCUMENTED",
        "E2_SOURCE_STATIC",
        "E3_TEST_RECEIPT",
        "E4_RUNTIME_OBSERVED",
        "E5_DEVICE_CERTIFIED",
        "E6_OWNER_VISUALLY_ACCEPTED"
      ]
    },
    "input_snapshot_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "mandatory_exit_veto": {
      "const": false
    },
    "model_id": {
      "minLength": 1,
      "type": "string"
    },
    "question_set_id": {
      "minLength": 1,
      "type": "string"
    },
    "question_set_version": {
      "minLength": 1,
      "type": "string"
    },
    "reality": {
      "enum": [
        "SYNTHETIC",
        "OBSERVED",
        "MODELED",
        "DERIVED"
      ]
    },
    "record_id": {
      "minLength": 1,
      "type": "string"
    },
    "research_source_class": {
      "enum": [
        "RS1_PRIMARY",
        "RS2_REPEATABLE_RESEARCH",
        "RS3_VENDOR_CAPABILITY",
        "RS4_SELF_REPORTED",
        "RS5_UNVERIFIED_CREATOR",
        "SYNTHETIC",
        "NOT_APPLICABLE"
      ]
    },
    "schema_version": {
      "const": "1.0"
    },
    "service_owner": {
      "const": "dial-jev"
    },
    "source_refs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "trade_authorized": {
      "const": false
    },
    "use": {
      "enum": [
        "EXPLANATION",
        "RESEARCH",
        "ABSTENTION",
        "SCOPED_REDUCE_ONLY_REVIEW"
      ]
    }
  },
  "required": [
    "schema_version",
    "record_id",
    "reality",
    "research_source_class",
    "implementation_evidence_level",
    "available_at",
    "decision_cutoff",
    "expires_at",
    "source_refs",
    "trade_authorized",
    "service_owner",
    "question_set_id",
    "question_set_version",
    "input_snapshot_hash",
    "model_id",
    "answers",
    "use",
    "confidence_semantics",
    "hard_filter_override",
    "mandatory_exit_veto"
  ],
  "title": "TypedTradingJudgment",
  "type": "object"
}
