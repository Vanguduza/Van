{
  "$id": "urn:van:hva:ChainSourceObservation:1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Proposed Rev1.12 application contract. Examples and schema checks are documentary only; no implementation/permission implied.",
  "properties": {
    "actual_provider_receipt_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "available_at": {
      "format": "date-time",
      "type": "string"
    },
    "cursor": {
      "minLength": 1,
      "type": "string"
    },
    "decision_cutoff": {
      "format": "date-time",
      "type": "string"
    },
    "endpoint_capability": {
      "enum": [
        "DISCOVER",
        "READ_STATE",
        "READ_HISTORY",
        "READ_QUOTE",
        "SIMULATE_READ_ONLY"
      ]
    },
    "entitlement_state": {
      "enum": [
        "PERMITTED_EXISTING_ACCESS",
        "UNVERIFIED",
        "DENIED",
        "EXPIRED"
      ]
    },
    "expires_at": {
      "format": "date-time",
      "type": "string"
    },
    "implementation_evidence_level": {
      "enum": [
        "SPEC_ONLY",
        "E0_OWNER_REFERENCE",
        "E1_DOCUMENTED",
        "E2_SOURCE_STATIC",
        "E3_TEST_RECEIPT",
        "E4_RUNTIME_OBSERVED",
        "E5_DEVICE_CERTIFIED",
        "E6_OWNER_VISUALLY_ACCEPTED"
      ]
    },
    "new_purchase_required": {
      "const": false
    },
    "observed_at": {
      "format": "date-time",
      "type": "string"
    },
    "payload_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "provider": {
      "minLength": 1,
      "type": "string"
    },
    "reality": {
      "enum": [
        "SYNTHETIC",
        "OBSERVED",
        "MODELED",
        "DERIVED"
      ]
    },
    "record_id": {
      "minLength": 1,
      "type": "string"
    },
    "research_source_class": {
      "enum": [
        "RS1_PRIMARY",
        "RS2_REPEATABLE_RESEARCH",
        "RS3_VENDOR_CAPABILITY",
        "RS4_SELF_REPORTED",
        "RS5_UNVERIFIED_CREATOR",
        "SYNTHETIC",
        "NOT_APPLICABLE"
      ]
    },
    "schema_version": {
      "const": "1.0"
    },
    "source_published_at": {
      "format": "date-time",
      "type": "string"
    },
    "source_refs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "state_anchor": {
      "additionalProperties": false,
      "properties": {
        "chain_id": {
          "minLength": 1,
          "type": "string"
        },
        "finality": {
          "enum": [
            "FINALIZED",
            "CONFIRMED",
            "UNFINALIZED",
            "UNKNOWN"
          ]
        },
        "hash": {
          "minLength": 1,
          "type": "string"
        },
        "height": {
          "minimum": 0,
          "type": "integer"
        },
        "state_epoch": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "chain_id",
        "height",
        "hash",
        "finality",
        "state_epoch"
      ],
      "type": "object"
    },
    "trade_authorized": {
      "const": false
    }
  },
  "required": [
    "schema_version",
    "record_id",
    "reality",
    "research_source_class",
    "implementation_evidence_level",
    "available_at",
    "decision_cutoff",
    "expires_at",
    "source_refs",
    "trade_authorized",
    "provider",
    "endpoint_capability",
    "entitlement_state",
    "observed_at",
    "source_published_at",
    "payload_sha256",
    "cursor",
    "state_anchor",
    "actual_provider_receipt_ref",
    "new_purchase_required"
  ],
  "title": "ChainSourceObservation",
  "type": "object"
}
