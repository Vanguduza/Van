{
  "$id": "urn:van:hva:ExecutionEconomicsForecast:1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Proposed Rev1.12 application contract. Examples and schema checks are documentary only; no implementation/permission implied.",
  "properties": {
    "applicability": {
      "enum": [
        "IN_DOMAIN",
        "UNKNOWN",
        "OUT_OF_DOMAIN"
      ]
    },
    "asset_id": {
      "minLength": 1,
      "type": "string"
    },
    "available_at": {
      "format": "date-time",
      "type": "string"
    },
    "calibration_id": {
      "minLength": 1,
      "type": "string"
    },
    "calibration_state": {
      "enum": [
        "VALID",
        "EXPIRED",
        "UNQUALIFIED"
      ]
    },
    "cash_currency": {
      "minLength": 1,
      "type": "string"
    },
    "decision_cutoff": {
      "format": "date-time",
      "type": "string"
    },
    "expected_exit_proceeds": {
      "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
      "type": "string"
    },
    "expires_at": {
      "format": "date-time",
      "type": "string"
    },
    "failure_cost": {
      "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
      "type": "string"
    },
    "feature_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "horizon_seconds": {
      "minimum": 1,
      "type": "integer"
    },
    "implementation_evidence_level": {
      "enum": [
        "SPEC_ONLY",
        "E0_OWNER_REFERENCE",
        "E1_DOCUMENTED",
        "E2_SOURCE_STATIC",
        "E3_TEST_RECEIPT",
        "E4_RUNTIME_OBSERVED",
        "E5_DEVICE_CERTIFIED",
        "E6_OWNER_VISUALLY_ACCEPTED"
      ]
    },
    "included_in_exit_proceeds": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 0,
      "type": "array",
      "uniqueItems": true
    },
    "incremental_costs": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "cash_amount": {
            "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
            "type": "string"
          },
          "component": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "component",
          "cash_amount"
        ],
        "type": "object"
      },
      "minItems": 0,
      "type": "array",
      "uniqueItems": true
    },
    "model_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "p_fill": {
      "maximum": 1,
      "minimum": 0,
      "type": "number"
    },
    "quantity": {
      "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
      "type": "string"
    },
    "quantity_unit": {
      "minLength": 1,
      "type": "string"
    },
    "quote_ref": {
      "minLength": 1,
      "type": "string"
    },
    "reality": {
      "enum": [
        "SYNTHETIC",
        "OBSERVED",
        "MODELED",
        "DERIVED"
      ]
    },
    "record_id": {
      "minLength": 1,
      "type": "string"
    },
    "research_source_class": {
      "enum": [
        "RS1_PRIMARY",
        "RS2_REPEATABLE_RESEARCH",
        "RS3_VENDOR_CAPABILITY",
        "RS4_SELF_REPORTED",
        "RS5_UNVERIFIED_CREATOR",
        "SYNTHETIC",
        "NOT_APPLICABLE"
      ]
    },
    "schema_version": {
      "const": "1.0"
    },
    "side": {
      "enum": [
        "BUY",
        "SELL"
      ]
    },
    "source_refs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "target_id": {
      "minLength": 1,
      "type": "string"
    },
    "trade_authorized": {
      "const": false
    }
  },
  "required": [
    "schema_version",
    "record_id",
    "reality",
    "research_source_class",
    "implementation_evidence_level",
    "available_at",
    "decision_cutoff",
    "expires_at",
    "source_refs",
    "trade_authorized",
    "quote_ref",
    "asset_id",
    "side",
    "quantity",
    "quantity_unit",
    "cash_currency",
    "target_id",
    "horizon_seconds",
    "model_hash",
    "feature_hash",
    "calibration_id",
    "calibration_state",
    "applicability",
    "p_fill",
    "expected_exit_proceeds",
    "incremental_costs",
    "included_in_exit_proceeds",
    "failure_cost"
  ],
  "title": "ExecutionEconomicsForecast",
  "type": "object"
}
