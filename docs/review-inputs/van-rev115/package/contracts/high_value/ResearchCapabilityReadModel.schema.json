{
  "$id": "urn:van:hva:ResearchCapabilityReadModel:1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Proposed Rev1.12 application contract. Examples and schema checks are documentary only; no implementation/permission implied.",
  "properties": {
    "actual_runtime_receipt_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "available_at": {
      "format": "date-time",
      "type": "string"
    },
    "capability_id": {
      "minLength": 1,
      "type": "string"
    },
    "completion_by_fixture": {
      "const": false
    },
    "decision_cutoff": {
      "format": "date-time",
      "type": "string"
    },
    "economic_state": {
      "enum": [
        "NOT_EVALUATED",
        "INCONCLUSIVE",
        "REJECTED",
        "DEFENSIVE_ONLY",
        "QUALIFIED_SCOPED"
      ]
    },
    "engineering_state": {
      "enum": [
        "NOT_STARTED",
        "IMPLEMENTED",
        "INTEGRATION_UNVERIFIED",
        "E2E_VERIFIED"
      ]
    },
    "expires_at": {
      "format": "date-time",
      "type": "string"
    },
    "financial_authority_state": {
      "const": "NONE_GRANTED_BY_ADDITIVE"
    },
    "funnel_counts": {
      "additionalProperties": false,
      "properties": {
        "discovered": {
          "minimum": 0,
          "type": "integer"
        },
        "rejected": {
          "minimum": 0,
          "type": "integer"
        },
        "research_eligible": {
          "minimum": 0,
          "type": "integer"
        },
        "unknown": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "discovered",
        "rejected",
        "unknown",
        "research_eligible"
      ],
      "type": "object"
    },
    "implementation_evidence_level": {
      "enum": [
        "SPEC_ONLY",
        "E0_OWNER_REFERENCE",
        "E1_DOCUMENTED",
        "E2_SOURCE_STATIC",
        "E3_TEST_RECEIPT",
        "E4_RUNTIME_OBSERVED",
        "E5_DEVICE_CERTIFIED",
        "E6_OWNER_VISUALLY_ACCEPTED"
      ]
    },
    "new_frontend_gate": {
      "const": "BG-001"
    },
    "provider_state": {
      "enum": [
        "UNAVAILABLE",
        "CONTRACT_FIXTURE",
        "OBSERVED",
        "QUALIFIED",
        "REVOKED"
      ]
    },
    "reality": {
      "enum": [
        "SYNTHETIC",
        "OBSERVED",
        "MODELED",
        "DERIVED"
      ]
    },
    "record_id": {
      "minLength": 1,
      "type": "string"
    },
    "research_source_class": {
      "enum": [
        "RS1_PRIMARY",
        "RS2_REPEATABLE_RESEARCH",
        "RS3_VENDOR_CAPABILITY",
        "RS4_SELF_REPORTED",
        "RS5_UNVERIFIED_CREATOR",
        "SYNTHETIC",
        "NOT_APPLICABLE"
      ]
    },
    "schema_version": {
      "const": "1.0"
    },
    "source_reality_label": {
      "enum": [
        "SYNTHETIC",
        "DELAYED",
        "OBSERVED",
        "UNVERIFIED"
      ]
    },
    "source_refs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "trade_authorized": {
      "const": false
    }
  },
  "required": [
    "schema_version",
    "record_id",
    "reality",
    "research_source_class",
    "implementation_evidence_level",
    "available_at",
    "decision_cutoff",
    "expires_at",
    "source_refs",
    "trade_authorized",
    "capability_id",
    "engineering_state",
    "provider_state",
    "economic_state",
    "financial_authority_state",
    "source_reality_label",
    "funnel_counts",
    "actual_runtime_receipt_ref",
    "new_frontend_gate",
    "completion_by_fixture"
  ],
  "title": "ResearchCapabilityReadModel",
  "type": "object"
}
