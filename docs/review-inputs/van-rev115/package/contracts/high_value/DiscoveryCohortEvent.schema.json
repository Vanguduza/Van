{
  "$id": "urn:van:hva:DiscoveryCohortEvent:1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Proposed Rev1.12 application contract. Examples and schema checks are documentary only; no implementation/permission implied.",
  "properties": {
    "asset_id": {
      "minLength": 1,
      "type": "string"
    },
    "available_at": {
      "format": "date-time",
      "type": "string"
    },
    "cohort_id": {
      "minLength": 1,
      "type": "string"
    },
    "decision_at": {
      "format": "date-time",
      "type": "string"
    },
    "decision_cutoff": {
      "format": "date-time",
      "type": "string"
    },
    "discovery_event_id": {
      "minLength": 1,
      "type": "string"
    },
    "expires_at": {
      "format": "date-time",
      "type": "string"
    },
    "first_seen_at": {
      "format": "date-time",
      "type": "string"
    },
    "implementation_evidence_level": {
      "enum": [
        "SPEC_ONLY",
        "E0_OWNER_REFERENCE",
        "E1_DOCUMENTED",
        "E2_SOURCE_STATIC",
        "E3_TEST_RECEIPT",
        "E4_RUNTIME_OBSERVED",
        "E5_DEVICE_CERTIFIED",
        "E6_OWNER_VISUALLY_ACCEPTED"
      ]
    },
    "outcome_state": {
      "enum": [
        "NOT_MATURED",
        "OBSERVED",
        "CENSORED",
        "MISSING"
      ]
    },
    "pool_id": {
      "minLength": 1,
      "type": "string"
    },
    "reality": {
      "enum": [
        "SYNTHETIC",
        "OBSERVED",
        "MODELED",
        "DERIVED"
      ]
    },
    "reason_codes": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "record_id": {
      "minLength": 1,
      "type": "string"
    },
    "research_source_class": {
      "enum": [
        "RS1_PRIMARY",
        "RS2_REPEATABLE_RESEARCH",
        "RS3_VENDOR_CAPABILITY",
        "RS4_SELF_REPORTED",
        "RS5_UNVERIFIED_CREATOR",
        "SYNTHETIC",
        "NOT_APPLICABLE"
      ]
    },
    "schema_version": {
      "const": "1.0"
    },
    "screening_version": {
      "minLength": 1,
      "type": "string"
    },
    "source_cursor": {
      "minLength": 1,
      "type": "string"
    },
    "source_refs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "state_anchor": {
      "additionalProperties": false,
      "properties": {
        "chain_id": {
          "minLength": 1,
          "type": "string"
        },
        "finality": {
          "enum": [
            "FINALIZED",
            "CONFIRMED",
            "UNFINALIZED",
            "UNKNOWN"
          ]
        },
        "hash": {
          "minLength": 1,
          "type": "string"
        },
        "height": {
          "minimum": 0,
          "type": "integer"
        },
        "state_epoch": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "chain_id",
        "height",
        "hash",
        "finality",
        "state_epoch"
      ],
      "type": "object"
    },
    "status": {
      "enum": [
        "DISCOVERED",
        "REJECTED",
        "UNKNOWN",
        "INVESTIGATE",
        "ELIGIBLE_FOR_RESEARCH",
        "MIGRATED",
        "DELISTED",
        "EXPIRED",
        "UNREACHABLE"
      ]
    },
    "trade_authorized": {
      "const": false
    }
  },
  "required": [
    "schema_version",
    "record_id",
    "reality",
    "research_source_class",
    "implementation_evidence_level",
    "available_at",
    "decision_cutoff",
    "expires_at",
    "source_refs",
    "trade_authorized",
    "cohort_id",
    "asset_id",
    "pool_id",
    "discovery_event_id",
    "first_seen_at",
    "decision_at",
    "screening_version",
    "status",
    "reason_codes",
    "state_anchor",
    "outcome_state",
    "source_cursor"
  ],
  "title": "DiscoveryCohortEvent",
  "type": "object"
}
