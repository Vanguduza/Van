{
  "$id": "urn:van:hva:ChainSecurityFinding:1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Proposed Rev1.12 application contract. Examples and schema checks are documentary only; no implementation/permission implied.",
  "properties": {
    "analyzer_version": {
      "minLength": 1,
      "type": "string"
    },
    "asset_id": {
      "minLength": 1,
      "type": "string"
    },
    "available_at": {
      "format": "date-time",
      "type": "string"
    },
    "chain_family": {
      "enum": [
        "EVM",
        "SOLANA"
      ]
    },
    "decision_cutoff": {
      "format": "date-time",
      "type": "string"
    },
    "expires_at": {
      "format": "date-time",
      "type": "string"
    },
    "factual_restrictions": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 0,
      "type": "array",
      "uniqueItems": true
    },
    "freeze_authority": {
      "enum": [
        "YES",
        "NO",
        "UNKNOWN"
      ]
    },
    "implementation_evidence_level": {
      "enum": [
        "SPEC_ONLY",
        "E0_OWNER_REFERENCE",
        "E1_DOCUMENTED",
        "E2_SOURCE_STATIC",
        "E3_TEST_RECEIPT",
        "E4_RUNTIME_OBSERVED",
        "E5_DEVICE_CERTIFIED",
        "E6_OWNER_VISUALLY_ACCEPTED"
      ]
    },
    "mint_authority": {
      "enum": [
        "YES",
        "NO",
        "UNKNOWN"
      ]
    },
    "permission_to_buy": {
      "const": false
    },
    "reality": {
      "enum": [
        "SYNTHETIC",
        "OBSERVED",
        "MODELED",
        "DERIVED"
      ]
    },
    "reason_codes": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "record_id": {
      "minLength": 1,
      "type": "string"
    },
    "research_source_class": {
      "enum": [
        "RS1_PRIMARY",
        "RS2_REPEATABLE_RESEARCH",
        "RS3_VENDOR_CAPABILITY",
        "RS4_SELF_REPORTED",
        "RS5_UNVERIFIED_CREATOR",
        "SYNTHETIC",
        "NOT_APPLICABLE"
      ]
    },
    "schema_version": {
      "const": "1.0"
    },
    "source_refs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "state_anchor": {
      "additionalProperties": false,
      "properties": {
        "chain_id": {
          "minLength": 1,
          "type": "string"
        },
        "finality": {
          "enum": [
            "FINALIZED",
            "CONFIRMED",
            "UNFINALIZED",
            "UNKNOWN"
          ]
        },
        "hash": {
          "minLength": 1,
          "type": "string"
        },
        "height": {
          "minimum": 0,
          "type": "integer"
        },
        "state_epoch": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "chain_id",
        "height",
        "hash",
        "finality",
        "state_epoch"
      ],
      "type": "object"
    },
    "trade_authorized": {
      "const": false
    },
    "unsupported_capabilities": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 0,
      "type": "array",
      "uniqueItems": true
    },
    "upgrade_authority": {
      "enum": [
        "YES",
        "NO",
        "UNKNOWN"
      ]
    },
    "verdict": {
      "enum": [
        "REJECT",
        "INVESTIGATE",
        "NO_HARD_BLOCK"
      ]
    }
  },
  "required": [
    "schema_version",
    "record_id",
    "reality",
    "research_source_class",
    "implementation_evidence_level",
    "available_at",
    "decision_cutoff",
    "expires_at",
    "source_refs",
    "trade_authorized",
    "asset_id",
    "chain_family",
    "analyzer_version",
    "state_anchor",
    "mint_authority",
    "freeze_authority",
    "upgrade_authority",
    "unsupported_capabilities",
    "factual_restrictions",
    "verdict",
    "reason_codes",
    "permission_to_buy"
  ],
  "title": "ChainSecurityFinding",
  "type": "object"
}
