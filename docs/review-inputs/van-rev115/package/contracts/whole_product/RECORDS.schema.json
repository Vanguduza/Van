{
  "$defs": {
    "Artifact": {
      "additionalProperties": false,
      "properties": {
        "ref": {
          "minLength": 1,
          "type": "string"
        },
        "schema_ref": {
          "minLength": 1,
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "ref",
        "sha256",
        "schema_ref"
      ],
      "type": "object"
    },
    "Budget": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "qualification_state": {
                "enum": [
                  "MEASURED_PASS",
                  "MEASURED_FAIL"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "receipt_refs": {
                "items": {
                  "minLength": 1,
                  "type": "string"
                },
                "minItems": 1,
                "type": "array",
                "uniqueItems": true
              }
            }
          }
        }
      ],
      "properties": {
        "budget_id": {
          "minLength": 1,
          "type": "string"
        },
        "domain": {
          "minLength": 1,
          "type": "string"
        },
        "measurement_protocol_ref": {
          "minLength": 1,
          "type": "string"
        },
        "metric": {
          "minLength": 1,
          "type": "string"
        },
        "profile": {
          "minLength": 1,
          "type": "string"
        },
        "qualification_state": {
          "enum": [
            "TARGET",
            "MEASURED_PASS",
            "MEASURED_FAIL"
          ]
        },
        "receipt_refs": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 0,
          "type": "array",
          "uniqueItems": true
        },
        "source_config_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "threshold": {
          "minimum": 0,
          "type": "number"
        },
        "unit": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "budget_id",
        "domain",
        "profile",
        "metric",
        "unit",
        "threshold",
        "measurement_protocol_ref",
        "source_config_digest",
        "qualification_state",
        "receipt_refs"
      ],
      "type": "object"
    },
    "CapabilityBinding": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "qualification_state": {
                "const": "QUALIFIED"
              }
            }
          },
          "then": {
            "properties": {
              "qualification_receipt_refs": {
                "items": {
                  "minLength": 1,
                  "type": "string"
                },
                "minItems": 1,
                "type": "array",
                "uniqueItems": true
              }
            }
          }
        }
      ],
      "properties": {
        "authority_policy_ref": {
          "minLength": 1,
          "type": "string"
        },
        "capability_id": {
          "minLength": 1,
          "type": "string"
        },
        "classification": {
          "enum": [
            "READ",
            "DRAFT",
            "EFFECT",
            "LOCAL"
          ]
        },
        "consumer_ref": {
          "minLength": 1,
          "type": "string"
        },
        "error_schema_ref": {
          "minLength": 1,
          "type": "string"
        },
        "handler_ref": {
          "minLength": 1,
          "type": "string"
        },
        "idempotency_scope": {
          "minLength": 1,
          "type": "string"
        },
        "input_schema_ref": {
          "minLength": 1,
          "type": "string"
        },
        "native_owner": {
          "minLength": 1,
          "type": "string"
        },
        "operation_id": {
          "minLength": 1,
          "type": "string"
        },
        "outcome_lookup_ref": {
          "minLength": 1,
          "type": "string"
        },
        "output_schema_ref": {
          "minLength": 1,
          "type": "string"
        },
        "qualification_receipt_refs": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 0,
          "type": "array",
          "uniqueItems": true
        },
        "qualification_state": {
          "enum": [
            "NOT_QUALIFIED",
            "QUALIFIED",
            "REVOKED"
          ]
        },
        "source_config_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "subject_scope": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "transport": {
          "enum": [
            "HTTP",
            "SSE",
            "WEBSOCKET",
            "RPC",
            "LOCAL"
          ]
        }
      },
      "required": [
        "capability_id",
        "operation_id",
        "native_owner",
        "classification",
        "transport",
        "handler_ref",
        "input_schema_ref",
        "output_schema_ref",
        "error_schema_ref",
        "subject_scope",
        "consumer_ref",
        "authority_policy_ref",
        "idempotency_scope",
        "outcome_lookup_ref",
        "source_config_digest",
        "qualification_state",
        "qualification_receipt_refs"
      ],
      "type": "object"
    },
    "Command": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "classification": {
                "const": "EFFECT"
              }
            }
          },
          "then": {
            "properties": {
              "proof_ref": {
                "minLength": 1,
                "type": "string"
              }
            }
          }
        }
      ],
      "properties": {
        "arguments": {
          "$ref": "#/$defs/Artifact"
        },
        "classification": {
          "enum": [
            "READ",
            "EFFECT"
          ]
        },
        "command_id": {
          "minLength": 1,
          "type": "string"
        },
        "consent_epoch": {
          "minimum": 0,
          "type": "integer"
        },
        "expected_revision": {
          "minLength": 1,
          "type": "string"
        },
        "expires_at": {
          "format": "date-time",
          "type": "string"
        },
        "idempotency_key": {
          "minLength": 1,
          "type": "string"
        },
        "operation_id": {
          "minLength": 1,
          "type": "string"
        },
        "proof_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "version": {
          "const": "1.0"
        }
      },
      "required": [
        "version",
        "command_id",
        "operation_id",
        "scope",
        "expected_revision",
        "arguments",
        "expires_at",
        "classification",
        "consent_epoch",
        "proof_ref",
        "idempotency_key"
      ],
      "type": "object"
    },
    "EventEnvelope": {
      "additionalProperties": false,
      "properties": {
        "authority_effect": {
          "const": "NONE"
        },
        "epoch": {
          "minLength": 1,
          "type": "string"
        },
        "event_id": {
          "minLength": 1,
          "type": "string"
        },
        "freshness": {
          "enum": [
            "CURRENT",
            "STALE",
            "UNKNOWN"
          ]
        },
        "occurred_at": {
          "format": "date-time",
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/Artifact"
        },
        "received_at": {
          "format": "date-time",
          "type": "string"
        },
        "sequence": {
          "minimum": 0,
          "type": "integer"
        },
        "snapshot_revision": {
          "minLength": 1,
          "type": "string"
        },
        "source_id": {
          "minLength": 1,
          "type": "string"
        },
        "stream_id": {
          "minLength": 1,
          "type": "string"
        },
        "subject_id": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "stream_id",
        "epoch",
        "sequence",
        "event_id",
        "subject_id",
        "snapshot_revision",
        "occurred_at",
        "received_at",
        "payload",
        "freshness",
        "authority_effect"
      ],
      "type": "object"
    },
    "Outcome": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "SUCCEEDED",
                  "CANCELLED"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "native_operation_id": {
                "minLength": 1,
                "type": "string"
              },
              "postcondition_receipt_refs": {
                "items": {
                  "minLength": 1,
                  "type": "string"
                },
                "minItems": 1,
                "type": "array",
                "uniqueItems": true
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "OUTCOME_UNKNOWN"
              }
            }
          },
          "then": {
            "properties": {
              "error_code": {
                "const": "OUTCOME_UNKNOWN"
              },
              "retry_policy": {
                "const": "RECONCILE_ORIGINAL"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "REFUSED",
                  "FAILED"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "error_code": {
                "minLength": 1,
                "type": "string"
              }
            }
          }
        }
      ],
      "properties": {
        "command_id": {
          "minLength": 1,
          "type": "string"
        },
        "error_code": {
          "type": [
            "string",
            "null"
          ]
        },
        "native_operation_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "observed_at": {
          "format": "date-time",
          "type": "string"
        },
        "postcondition_receipt_refs": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 0,
          "type": "array",
          "uniqueItems": true
        },
        "recovery_lookup_ref": {
          "minLength": 1,
          "type": "string"
        },
        "retry_policy": {
          "enum": [
            "READ_ONLY",
            "RECONCILE_ORIGINAL",
            "NEW_INTENT_AFTER_REVIEW",
            "NONE"
          ]
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "source_revision": {
          "minLength": 1,
          "type": "string"
        },
        "state": {
          "enum": [
            "ACCEPTED",
            "DISPATCHING",
            "RUNNING",
            "SUCCEEDED",
            "REFUSED",
            "FAILED",
            "CANCEL_REQUESTED",
            "CANCELLED",
            "OUTCOME_UNKNOWN"
          ]
        }
      },
      "required": [
        "command_id",
        "native_operation_id",
        "state",
        "scope",
        "source_revision",
        "observed_at",
        "postcondition_receipt_refs",
        "error_code",
        "recovery_lookup_ref",
        "retry_policy"
      ],
      "type": "object"
    },
    "ProvisioningEnvelope": {
      "additionalProperties": false,
      "properties": {
        "application_id": {
          "const": "com.dial.van"
        },
        "audience": {
          "minLength": 1,
          "type": "string"
        },
        "configuration_epoch": {
          "minimum": 1,
          "type": "integer"
        },
        "enrollment_ref": {
          "minLength": 1,
          "type": "string"
        },
        "expires_at": {
          "format": "date-time",
          "type": "string"
        },
        "issued_at": {
          "format": "date-time",
          "type": "string"
        },
        "issuer": {
          "minLength": 1,
          "type": "string"
        },
        "key_id": {
          "minLength": 1,
          "type": "string"
        },
        "nonce": {
          "minLength": 1,
          "type": "string"
        },
        "route_set_ref": {
          "minLength": 1,
          "type": "string"
        },
        "signature_ref": {
          "minLength": 1,
          "type": "string"
        },
        "signing_lineage_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "version": {
          "const": "1.0"
        }
      },
      "required": [
        "version",
        "issuer",
        "key_id",
        "audience",
        "application_id",
        "signing_lineage_digest",
        "configuration_epoch",
        "issued_at",
        "expires_at",
        "nonce",
        "route_set_ref",
        "enrollment_ref",
        "signature_ref"
      ],
      "type": "object"
    },
    "Scope": {
      "additionalProperties": false,
      "properties": {
        "account_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "authority_epoch": {
          "minimum": 0,
          "type": "integer"
        },
        "device_id": {
          "minLength": 1,
          "type": "string"
        },
        "domain": {
          "minLength": 1,
          "type": "string"
        },
        "owner_id": {
          "minLength": 1,
          "type": "string"
        },
        "project_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "subject_id": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "owner_id",
        "device_id",
        "domain",
        "subject_id",
        "account_id",
        "project_id",
        "authority_epoch"
      ],
      "type": "object"
    },
    "VoiceEvent": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "spoken_completion": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "command_id": {
                "minLength": 1,
                "type": "string"
              },
              "verified_outcome_ref": {
                "minLength": 1,
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "event_type": {
                "const": "PARTIAL_TRANSCRIPT"
              }
            }
          },
          "then": {
            "properties": {
              "command_id": {
                "type": "null"
              },
              "spoken_completion": {
                "const": false
              }
            }
          }
        }
      ],
      "properties": {
        "command_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "consent_epoch": {
          "minimum": 0,
          "type": "integer"
        },
        "event_type": {
          "enum": [
            "LISTENING",
            "PARTIAL_TRANSCRIPT",
            "FINAL_TRANSCRIPT",
            "CLARIFICATION",
            "COMMAND_ACCEPTED",
            "COMMAND_OUTCOME",
            "AUDIO_CHUNK",
            "PLAYBACK_COMPLETE",
            "INTERRUPTED",
            "CANCELLED",
            "ERROR"
          ]
        },
        "generation": {
          "minimum": 0,
          "type": "integer"
        },
        "payload_ref": {
          "minLength": 1,
          "type": "string"
        },
        "sequence": {
          "minimum": 0,
          "type": "integer"
        },
        "session_id": {
          "minLength": 1,
          "type": "string"
        },
        "spoken_completion": {
          "type": "boolean"
        },
        "turn_id": {
          "minLength": 1,
          "type": "string"
        },
        "verified_outcome_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "session_id",
        "turn_id",
        "generation",
        "sequence",
        "consent_epoch",
        "event_type",
        "payload_ref",
        "command_id",
        "spoken_completion",
        "verified_outcome_ref"
      ],
      "type": "object"
    }
  },
  "$id": "urn:van:whole-product:records:1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
