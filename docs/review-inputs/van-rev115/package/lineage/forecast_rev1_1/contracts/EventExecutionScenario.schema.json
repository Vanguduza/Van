{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:van:forecast:prediction-market:EventExecutionScenario:1.0",
  "title": "EventExecutionScenario",
  "description": "Proposed VAN contract. JSON shape/local arithmetic is not evidence admission, source permission or financial authority.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "environment": {
      "enum": [
        "FIXTURE",
        "RESEARCH",
        "SHADOW"
      ]
    },
    "authority_effect": {
      "const": "NONE"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "source_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "scenario_id": {
      "type": "string",
      "minLength": 1
    },
    "contract_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "book_stream_ref": {
      "type": "string",
      "minLength": 1
    },
    "input_granularity": {
      "enum": [
        "FULL_DEPTH",
        "LEVEL2",
        "TRADES_ONLY",
        "CANDLES",
        "FIXTURE"
      ]
    },
    "fee_policy_ref": {
      "type": "string",
      "minLength": 1
    },
    "queue_policy_ref": {
      "type": "string",
      "minLength": 1
    },
    "touch_guarantees_fill": {
      "const": false
    },
    "cancel_request_is_final": {
      "const": false
    },
    "cash_before": {
      "type": "string",
      "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$"
    },
    "entry_cost": {
      "type": "string",
      "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$"
    },
    "fees": {
      "type": "string",
      "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$"
    },
    "other_cash_costs": {
      "type": "string",
      "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$"
    },
    "final_payout": {
      "type": "string",
      "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$"
    },
    "cash_after": {
      "type": "string",
      "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$"
    },
    "trade_close_at": {
      "type": "string",
      "format": "date-time"
    },
    "settled_at": {
      "type": "string",
      "format": "date-time"
    },
    "cash_available_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_evidence_claim": {
      "enum": [
        "FIXTURE_ONLY",
        "RESEARCH_DATA_WITH_LIMITATIONS",
        "ACTUAL_PERMISSIONED_CAPTURE"
      ]
    },
    "actual_broker_execution": {
      "const": false
    }
  },
  "required": [
    "schema_version",
    "record_id",
    "environment",
    "authority_effect",
    "evidence_refs",
    "source_digest",
    "scenario_id",
    "contract_digest",
    "book_stream_ref",
    "input_granularity",
    "fee_policy_ref",
    "queue_policy_ref",
    "touch_guarantees_fill",
    "cancel_request_is_final",
    "cash_before",
    "entry_cost",
    "fees",
    "other_cash_costs",
    "final_payout",
    "cash_after",
    "trade_close_at",
    "settled_at",
    "cash_available_at",
    "source_evidence_claim",
    "actual_broker_execution"
  ],
  "additionalProperties": false
}
