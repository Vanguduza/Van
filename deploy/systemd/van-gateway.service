[Unit]
Description=VAN secure owner-authority gateway
After=network-online.target hermes-gateway.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/.local/share/van/runtime/backend
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=%h/.local/share/van/runtime/backend
EnvironmentFile=%h/.config/van/google-workspace.env
EnvironmentFile=%h/.config/van/gateway.env
EnvironmentFile=-%h/.config/van/trading-commander.env
# Loopback 127.0.0.1:8787 exactly as before; plus the phone's direct mutual-TLS listener
# (0.0.0.0:8443) when gateway.env sets VAN_MTLS_ENABLED. See van_gateway/mtls/serve.py.
ExecStart=%h/.local/share/van/venv/bin/python -m van_gateway.mtls.serve
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/share/van %h/.local/state/van
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=default.target
