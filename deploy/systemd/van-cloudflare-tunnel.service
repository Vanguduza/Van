[Unit]
Description=VAN named Cloudflare Tunnel
After=network-online.target van-gateway.service
Requires=van-gateway.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/bin/cloudflared tunnel --no-autoupdate run --token-file %h/.config/van/cloudflare-tunnel.token
Restart=always
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=%h/.config/van/cloudflare-tunnel.token
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=default.target
