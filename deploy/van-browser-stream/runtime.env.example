# Rev 1.5 §13 — Browser Stream Host runtime configuration.
# Legacy single-profile development fixture only. Production uses --profile with
# profiles.example.json and separate public/owner Chromium/control/stream envs.
#
# Copy to /etc/van-browser-stream/runtime.env, chmod 600, owned by root.
# Nothing here is a secret except the PKI paths' contents; the credentials themselves live
# in files, not in this environment, so a process listing never shows one.

# The debugger. Never change the address: §13.2 and qualify.sh both depend on it.
VAN_BROWSER_CDP_PORT=9222

# OMV-008 exact-IP public-web proxy. Loopback only; Chromium removes its implicit
# localhost bypass so every HTTP(S) page/subresource goes through this mediator.
VAN_BROWSER_EGRESS_PORT=8899

# The private VCN address the control agent binds to. NOT 0.0.0.0, and not the public
# address: an agent reachable from the internet is the bridge this topology exists to avoid.
VAN_BROWSER_CONTROL_BIND=10.0.1.240
VAN_BROWSER_CONTROL_PORT=9443

# The public signalling/media endpoint.
VAN_BROWSER_STREAM_BIND=0.0.0.0
VAN_BROWSER_STREAM_PORT=8443
VAN_BROWSER_SIGNAL_PATH=/rtc

# §13.5 option A — an encrypted volume attached only to this host.
VAN_BROWSER_PROFILE_MOUNT=/var/lib/van-browser-profiles
VAN_BROWSER_PROFILE_ALIAS=authenticated_owner

# The viewport Chromium starts at. The device proposes its own and the session negotiates
# a revision; this is only what the browser looks like before a phone attaches.
VAN_BROWSER_WIDTH=1080
VAN_BROWSER_HEIGHT=2016

# mTLS. The CA here is private to this control path and is not the Gateway's, not the
# owner device root, and not a public CA (§13.3).
VAN_BROWSER_PKI_DIR=/opt/van-browser-stream/pki

# The ES256 public key the stream runtime verifies BrowserStreamGrant tokens with, and the
# kid it will accept. Both come from the Gateway; the host never mints a grant.
VAN_BROWSER_GRANT_PUBLIC_KEY=/opt/van-browser-stream/pki/grant-verify.pem
VAN_BROWSER_GRANT_KID=browser-stream-signing-1

# Exact native runtime is installed from requirements.lock (CPython 3.12 x86_64).
# Public media and private control use different protected files. Bind each token
# only to browser_stream_producer; NEVER bind a general browser/internal token here.
VAN_BROWSER_BROKER_ORIGIN=https://van-trading-core.internal:8443
VAN_BROWSER_BROKER_CA=/opt/van-browser-stream/pki/broker-ca.crt
VAN_BROWSER_CONTROL_BROKER_TOKEN_FILE=/opt/van-browser-stream/pki/control-producer.token
VAN_BROWSER_STREAM_BROKER_TOKEN_FILE=/opt/van-browser-stream/pki/stream-producer.token
# Independently bound SHA-256 of each stripped role token; empty deliberately
# refuses runtime startup. Four distinct fingerprints are used by production stacks.
VAN_BROWSER_CONTROL_BROKER_TOKEN_SHA256=
VAN_BROWSER_STREAM_BROKER_TOKEN_SHA256=
# If broker ingress requires service mTLS, bind its independent scoped pair here.
VAN_BROWSER_BROKER_CLIENT_CERT=
VAN_BROWSER_BROKER_CLIENT_KEY=

VAN_BROWSER_STREAM_TLS_CERT=/opt/van-browser-stream/pki/stream.crt
VAN_BROWSER_STREAM_TLS_KEY=/opt/van-browser-stream/pki/stream.key
VAN_BROWSER_QUARANTINE_ROOT=/var/lib/van-browser-transfers
# Explicit one-use owner grants allow clipboard buttons. Automatic clipboard sync
# is always absent/off; setting this to 0 disables even explicit actions.
VAN_BROWSER_CLIPBOARD_ENABLED=1
# Operator binds existing TURN/STUN here; credentials stay in protected runtime.env.
# Example non-secret shape: [{"urls":["turns:turn.example:5349"],"username":"...","credential":"..."}]
VAN_BROWSER_ICE_SERVERS_JSON=[]
