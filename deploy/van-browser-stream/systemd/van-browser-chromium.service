# Rev 1.5 §13.2 — the browser the owner sees, with its debugger fenced to loopback.
#
# `--remote-debugging-address=127.0.0.1` is the line this whole host is designed around.
# Chromium's default when a port is given without an address has changed between versions
# and has been "all interfaces" before; naming the address is not redundant, it is the
# difference between a private debugger and a public remote-code-execution endpoint.
[Unit]
Description=VAN Browser Stream Host — Chromium (loopback CDP only)
After=network-online.target van-browser-profiles.mount
Requires=van-browser-profiles.mount

[Service]
Type=simple
User=van-browser
Group=van-browser
EnvironmentFile=/etc/van-browser-stream/runtime.env
ExecStart=/usr/bin/chromium \
  --remote-debugging-address=127.0.0.1 \
  --remote-debugging-port=${VAN_BROWSER_CDP_PORT} \
  --remote-allow-origins=http://127.0.0.1:${VAN_BROWSER_CDP_PORT} \
  --user-data-dir=${VAN_BROWSER_PROFILE_MOUNT}/${VAN_BROWSER_PROFILE_ALIAS} \
  --window-size=${VAN_BROWSER_WIDTH},${VAN_BROWSER_HEIGHT} \
  --force-device-scale-factor=1 \
  --no-first-run \
  --disable-features=Translate,MediaRouter \
  --autoplay-policy=no-user-gesture-required
Restart=on-failure
RestartSec=5

# The browser holds the owner's logged-in sessions. Everything below is about what it can
# reach if a page ever escapes it.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
ReadWritePaths=${VAN_BROWSER_PROFILE_MOUNT}
# Deliberately absent: any access to /var/run/docker.sock. Membership of the docker group
# is root on this host, one API call away, and this user must never have it.

[Install]
WantedBy=multi-user.target
