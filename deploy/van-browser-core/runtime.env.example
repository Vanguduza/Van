# van-browser-core runtime configuration (owner decision 2026-09-29 §1).
#
# Installed by bootstrap.sh to /etc/van-browser-core/runtime.env, mode 0640 root:van-browser.
# Nothing in this file is a secret. The Stagehand provider credential is a file-backed
# secret reference resolved inside VAN_BROWSER_SECRET_ROOT; this file names it, never holds it.
#
# This zone holds NO credential, path or socket of another trust zone (the list of
# excluded authorities is zone.json "no_direct_authority_over").
# tests/contracts/test_van_browser_core_zone.py fails the build if one appears here.

# Trust zone identity. The workers report it on /health and refuse to start without it.
VAN_TRUST_ZONE=van-browser-core

# Released artifact identity (§5): @browserbasehq/stagehand 4.1.0 = upstream release
# commit cd7b230778cf92269e4cb90e80d97f5113781c51, npm integrity
# sha512-PJikMBVoaCRh6TFD7GcmeISmsMq4IwUu1BD5FOsGUVDUxrVqZomWa6W6dF+a/zu4xRZu2Z2xX1nXVMDaCuZWsw==
VAN_STAGEHAND_VERSION=4.1.0
VAN_PLAYWRIGHT_VERSION=1.63.0

# Stagehand semantic worker: loopback only; reached cross-zone solely through the mTLS edge.
VAN_STAGEHAND_BIND=127.0.0.1
VAN_STAGEHAND_PORT=9140
# §4 — owner-decided model. The worker refuses a request naming any other model.
VAN_STAGEHAND_MODEL_PROVIDER=anthropic
VAN_STAGEHAND_MODEL_NAME=claude-sonnet-5
VAN_STAGEHAND_MODEL_KEY_REF=secretref://browser/stagehand-model

# Harness-owned Chromium and deterministic Browser Harness worker: loopback only.
VAN_HARNESS_INTERNAL_URL=http://127.0.0.1:9141
VAN_HARNESS_BIND=127.0.0.1
VAN_HARNESS_PORT=9141
VAN_BROWSER_HARNESS_BIN=/opt/van-browser-core/runtime/harness-venv/bin/browser-harness
VAN_CHROMIUM_EXECUTABLE=
VAN_BROWSER_WORKER_TIMEOUT_SECONDS=45

# Zone-local state. Nothing here is shared with another zone's filesystem.
VAN_BROWSER_RUNTIME_ROOT=/run/van-browser-core
VAN_BROWSER_PROFILE_ROOT=/var/lib/van-browser-core/profiles
VAN_BROWSER_SECRET_ROOT=/var/lib/van-browser-core/secrets
VAN_BROWSER_DOWNLOAD_ROOT=/var/lib/van-browser-core/downloads
VAN_BROWSER_EVIDENCE_ROOT=/var/lib/van-browser-core/evidence
# Review I4 MINOR-A: the Harness lease fence persists the newest lease generation it has
# seen per profile here, so a restart cannot re-admit a stale holder.
VAN_HARNESS_STATE_ROOT=/var/lib/van-browser-core/harness-state
# Review I5 F2: written by bootstrap.sh with the state directory. While it exists, lost fence
# state (a missing manifest, or a missing file for a profile the manifest lists) makes the
# Harness refuse fenced calls (503 LEASE_FENCE_STATE_MISSING) instead of forgetting them.
VAN_HARNESS_FENCE_INSTALL_MARKER=/etc/van-browser-core/harness-fence-installed
# Review I5 F3: the file holding the key the gateway MACs every lease fence with. bootstrap.sh
# generates it (>= 32 random bytes, mode 0400 van-browser); copy the same file to the gateway
# host and point VAN_BROWSER_HARNESS_FENCE_KEY_FILE at it. This names a path, never a key.
# With a trust zone set, the Harness refuses to start without a readable key.
VAN_HARNESS_FENCE_KEY_FILE=/var/lib/van-browser-core/secrets/harness-fence.key
PLAYWRIGHT_BROWSERS_PATH=/opt/van-browser-core/runtime/browsers

# mTLS edge: the only cross-zone listener. Private overlay address, never 0.0.0.0.
VAN_BROWSER_CORE_EDGE_BIND=
VAN_BROWSER_CORE_EDGE_PORT=9443
VAN_BROWSER_CORE_PKI_DIR=/etc/van-browser-core/pki
