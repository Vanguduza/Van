# Owner decision 2026-09-29 §3 — van-private-core runtime configuration.
#
# Copy to /etc/van-private-core/runtime.env, chmod 600, owned by root.

# The private overlay address the API binds to. Never 0.0.0.0 and never a public address:
# only bounded authenticated APIs may cross into this plane. The unit refuses a wildcard.
VAN_PRIVATE_CORE_BIND=
VAN_PRIVATE_CORE_PORT=9140

# The Owner Model store (owner_cognitive_model, owner_model_episodes,
# owner_model_revisions, owner_model_outbox). Local to this host; no other zone mounts it.
VAN_DATABASE_PATH=/var/lib/van-private-core/owner-model.sqlite3

# Owner-private Hindsight bank and owner-private OpenViking projection. Declared placement;
# the services themselves are an external provisioning gate (see
# docs/project-state/VAN_PRIVATE_CORE_TOPOLOGY_20260929.md). Loopback only.
VAN_PRIVATE_HINDSIGHT_DIR=/var/lib/van-private-core/hindsight-owner
VAN_PRIVATE_HINDSIGHT_BIND=127.0.0.1
VAN_PRIVATE_OPENVIKING_DIR=/var/lib/van-private-core/openviking-owner
VAN_PRIVATE_OPENVIKING_BIND=127.0.0.1

# mTLS: a CA private to this plane — not the gateway's, not the owner-device root.
VAN_PRIVATE_CORE_PKI_DIR=/opt/van-private-core/pki

# Scoped internal credential: `understanding:<token of at least 32 characters>`.
# Provisioned from a secret file at install time; never committed.
VAN_INTERNAL_CONTROL_SCOPED_TOKENS=
VAN_INTERNAL_CONTROL_TOKEN=
VAN_ENV=production
# Gateway production refusals (GAP-F-018/021) apply to the shared Settings model. The
# private core makes no Hermes and no public-URL calls, so the loopback defaults of those
# two gateway URLs are unused here; device binding stays required.
VAN_REQUIRE_DEVICE_BINDING=true
VAN_ALLOW_LOOPBACK_IN_PRODUCTION=1
