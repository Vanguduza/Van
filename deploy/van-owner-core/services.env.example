# Additional machine bindings for the audited owner features. These values are
# supplied by deployment and signed provisioning; Android has no host/port fields.
# Empty values deliberately leave the corresponding service unavailable.

# Browser: the signed origin/prefix admits isolated per-profile producers.
# Example shape only: {"public_research":"https://browser.example/rtc/public",
#                      "authenticated_owner":"https://browser.example/rtc/owner"}
VAN_BROWSER_STREAM_SIGNING_KEY_FILE=
VAN_BROWSER_STREAM_SIGNING_KID=browser-stream-signing-1
VAN_BROWSER_STREAM_SIGNAL_URL=
VAN_BROWSER_STREAM_PROFILE_SIGNAL_URLS={}
VAN_BROWSER_STREAM_ICE_SERVERS=[]

# Core -> native private control: certificate CA/SAN and TLS client identity are
# independently supplied. The public media process never receives this identity.
VAN_BROWSER_CONTROL_CLIENT_ADDRESS=
VAN_BROWSER_CONTROL_CLIENT_PORT=9443
VAN_BROWSER_CONTROL_CLIENT_SERVER_NAME=
VAN_BROWSER_CONTROL_CLIENT_CA_FILE=
VAN_BROWSER_CONTROL_CLIENT_CERT_FILE=
VAN_BROWSER_CONTROL_CLIENT_KEY_FILE=
VAN_BROWSER_CONTROL_CLIENT_COMMON_NAME=van-trading-core
VAN_BROWSER_CONTROL_PROXY_PRINCIPAL_SHA256=
# Match the separately installed native control and media role tokens. The core
# binds both as narrow browser_stream_producer credentials, and maps only CONTROL.
VAN_BROWSER_CONTROL_BROKER_TOKEN_SHA256=
VAN_BROWSER_STREAM_BROKER_TOKEN_SHA256=
# Token SHA-256 -> admitted verified client certificate CN list. Fingerprints are
# identifiers, not credentials. Media credentials must have no entry here.
VAN_BROWSER_CONTROL_PROXY_BINDINGS={}
# For isolated producers, the generated per-profile client map supersedes the
# single-instance fields. Each profile supplies its private endpoint/TLS paths,
# canonical core CN and separate control/media credential fingerprint identifiers.
VAN_BROWSER_CONTROL_PROFILE_CLIENTS={}

# Provisioned n8n helper workflows call the private canonical worker route.
# Use the actual admitted HTTPS core listener ending /v1/automation/worker/step.
# Bind separate automation_worker credentials to the provisioned n8n headerAuth
# credential. The worker also requires an exact signed per-run/per-step grant.
VAN_AUTOMATION_WORKER_ENDPOINT=
VAN_AUTOMATION_SOURCE_CREDENTIALS_FILE=

# Independent remote Git / exact-head GitHub Actions readback.
# Repository allowlist is operator-owned; the model cannot add origins.
VAN_GITHUB_VERIFICATION_REPOSITORIES=Vanguduza/Van,Vanguduza/dial-development-system
VAN_GITHUB_VERIFICATION_TOKEN_FILE=
