[Unit]
Description=Run the Van economic calendar recorder (TRD-REV51-090)

[Timer]
# Macro releases cluster on the half hour; a 15-minute cadence records the
# print and its early revisions without pretending to be a tick feed.
OnCalendar=*:0/15
AccuracySec=30s
Persistent=true

[Install]
WantedBy=timers.target
