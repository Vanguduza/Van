# VAN Temporal durable coordination runtime.
# A real Temporal server address is mandatory when this service is enabled.
VAN_TEMPORAL_ADDRESS=
VAN_TEMPORAL_NAMESPACE=van
VAN_TEMPORAL_TASK_QUEUE=van-critical
VAN_TEMPORAL_BRIDGE_HOST=127.0.0.1
VAN_TEMPORAL_BRIDGE_PORT=9150
VAN_TEMPORAL_BRIDGE_TOKEN_FILE=/opt/van-trading/secrets/temporal-bridge.token
VAN_TEMPORAL_EVIDENCE_ROOT=/var/lib/van-trading/evidence/temporal
