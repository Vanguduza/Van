# Copy to /etc/van-muse-egress.env as root:root mode 0600. Never commit real keys.
MUSE_WG_PRIVATE_KEY_FILE=/opt/van-muse-egress/secrets/wg-private.key
MUSE_WG_PEER_PUBLIC_KEY=REPLACE_ME
# Fixed public IPv4 and UDP port of a dedicated US/Canada WireGuard exit.
MUSE_WG_ENDPOINT=203.0.113.10:51820
# Client address allocated on the exit server.
MUSE_WG_ADDRESS=10.66.77.2/32
# Resolver traffic also crosses the tunnel.
MUSE_WG_DNS=1.1.1.1
# Health checks fail closed if public egress is anything else.
MUSE_EXPECTED_EGRESS_IP=203.0.113.10
