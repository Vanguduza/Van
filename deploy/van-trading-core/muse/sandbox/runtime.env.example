# gVisor Muse sandbox limits. Trading/VATI always has resource precedence.
MUSE_SANDBOX_CPU=0.75
MUSE_SANDBOX_MEMORY=4g
MUSE_SANDBOX_MEMORY_RESERVATION=2g
MUSE_SANDBOX_PIDS=512
MUSE_SANDBOX_PROFILE_MAX_MIB=8192
MUSE_SANDBOX_DOWNLOAD_MAX_MIB=2048

# Internal-only Docker network. It is created with --internal, so there is no direct
# Internet route even before nftables policy is applied.
MUSE_SANDBOX_NETWORK=van-muse-sandbox-net
MUSE_SANDBOX_BRIDGE=muse-sbx0
MUSE_SANDBOX_SUBNET=172.31.77.0/29
MUSE_SANDBOX_GATEWAY=172.31.77.1
MUSE_SANDBOX_IP=172.31.77.2

# Sandbox -> host -> hardened WireGuard SOCKS bridge.
MUSE_SANDBOX_PROXY_PORT=17892

# Host loopback endpoint consumed by the existing Browser Harness and Stagehand.
MUSE_SANDBOX_CDP_PORT=17922

# Root supervisor exists only inside gVisor. The host reaches it directly on the
# internal bridge using an authenticated token; it is never published publicly.
MUSE_SANDBOX_CONTROL_PORT=9230
MUSE_SANDBOX_CONTROL_TOKEN_FILE=/opt/van-muse-sandbox/secrets/control.token

MUSE_SANDBOX_PROFILE_DIR=/var/lib/van-muse-sandbox/profile
MUSE_SANDBOX_DOWNLOAD_DIR=/var/lib/van-muse-sandbox/downloads
MUSE_SANDBOX_IMAGE_ID=REPLACE_AFTER_BUILD
