# Non-secret production deployment configuration. Secrets are root-owned files.
N8N_VERSION=2.39.7
POSTGRES_VERSION=16.10
VAN_AUTOMATION_SECRETS_DIR=/opt/van-trading/secrets/automation
VAN_TIMEZONE=Africa/Harare
VAN_PUBLIC_HOST=

# Provisional deployment safety envelope; recertify from measured VATI load.
N8N_CONCURRENCY_LIMIT=1
N8N_RUNNER_CONCURRENCY=1
N8N_CPU_LIMIT=0.60
N8N_MEMORY_LIMIT=1536m
N8N_RUNNER_CPU_LIMIT=0.25
N8N_RUNNER_MEMORY_LIMIT=512m
N8N_POSTGRES_CPU_LIMIT=0.35
N8N_POSTGRES_MEMORY_LIMIT=1024m
VAN_AUTOMATION_RESOURCE_BUDGET_STATE=PROVISIONAL

# Future Gateway/AutomationCompiler integration points stay private.
VAN_AUTOMATION_EDITOR_URL=http://127.0.0.1:5678/
VAN_AUTOMATION_MANAGEMENT_URL=http://127.0.0.1:5678/api/v1
VAN_AUTOMATION_NETWORK=van_automation_net
VAN_AUTOMATION_EGRESS_NETWORK=van_automation_egress
