# Browser Fabric development/runtime foundation; listeners remain private.
VAN_STAGEHAND_VERSION=4.1.0
VAN_PLAYWRIGHT_VERSION=1.63.0
VAN_STAGEHAND_BIND=127.0.0.1
VAN_STAGEHAND_PORT=9140
VAN_HARNESS_BIND=127.0.0.1
VAN_HARNESS_PORT=9141
VAN_BROWSER_HARNESS_BIN=/opt/van-browser-runtime/harness-venv/bin/browser-harness
VAN_CHROMIUM_EXECUTABLE=
VAN_BROWSER_WORKER_TIMEOUT_SECONDS=45
VAN_BROWSER_RUNTIME_ROOT=/run/van-browser
VAN_BROWSER_PROFILE_ROOT=/var/lib/van-trading/browser/profiles
VAN_BROWSER_SECRET_ROOT=/var/lib/van-trading/browser/secrets
VAN_BROWSER_DOWNLOAD_ROOT=/var/lib/van-trading/browser/downloads
VAN_BROWSER_EVIDENCE_ROOT=/var/lib/van-trading/evidence/browser
VAN_AUTOMATION_EVIDENCE_ROOT=/var/lib/van-trading/evidence/automation
PLAYWRIGHT_BROWSERS_PATH=/opt/van-browser-runtime/browsers

# Durable critical-workflow client foundation. No local Temporal server is implied.
VAN_TEMPORAL_ENABLED=0
VAN_TEMPORAL_ADDRESS=
VAN_TEMPORAL_NAMESPACE=van
VAN_TEMPORAL_TASK_QUEUE=van-critical
TEMPORALIO_VERSION=1.33.0

# Delegated background VEKL worker. Bootstrap writes the discovered private IP.
VAN_VEKL_WORKER_HOST=
VAN_VEKL_WORKER_MODE=BOUNDED_ARTIFACT_DELEGATION
