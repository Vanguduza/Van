# /opt/van-trading/config/van-trading-core.env — copied by bootstrap.sh, mode 0640 root:vati
VAN_REPO=/opt/van-trading/app
VAN_DATA=/var/lib/van-trading
VAN_LOGS=/var/log/van-trading
VAN_SECRETS=/opt/van-trading/secrets
# Ledger: the Supabase PostgreSQL on this host (vati role created by supabase/init). SQLite fallback for OBSERVE/paper.
VAN_COMMANDER_LEDGER=postgres://vati:__VATI_LEDGER_PASSWORD__@127.0.0.1:5432/postgres
VAN_COMMANDER_TOKEN_FILE=/opt/van-trading/secrets/commander.token
VAN_COMMANDER_HEARTBEAT_DIR=/var/lib/van-trading/heartbeats
VAN_COMMANDER_LOG_DIR=/var/log/van-trading
VAN_COMMANDER_DATA_DIR=/var/lib/van-trading
VAN_COMMANDER_REPO=/opt/van-trading/app
VAN_COMMANDER_UNITS=vati-session@*.service,vati-commander.service,vati-vekl.service,vati-supabase.service,vati-mt5-tunnel.service
VAN_ACCOUNTS_REGISTRY=/opt/van-trading/config/accounts.json
VAN_OWNER_AUTHORITY_KEYS=/var/lib/van-trading/owner_authority_keys.json
VAN_COMMANDER_BIND=0.0.0.0
VAN_COMMANDER_PORT=9133
# Commander TLS (served by uvicorn): cert/key issued by pki/make-bridge-pki.sh for 10.0.1.233
VAN_COMMANDER_TLS_CERT=/opt/van-trading/secrets/pki/commander.crt
VAN_COMMANDER_TLS_KEY=/opt/van-trading/secrets/pki/commander.key
# Dedicated trading VEKL (loopback)
VEKL_HOME=/var/lib/van-trading/vekl
VEKL_PORT=9134
VEKL_HOST=127.0.0.1
VEKL_TOKEN_FILE=/opt/van-trading/secrets/vekl.token
VAN_VEKL_URL=http://127.0.0.1:9134
# MT5 pull bridge (VanBridgeEA): loopback service fronted by Caddy on the public host
VAN_MT5_PULL_QUEUE=/var/lib/van-trading/mt5-pull.sqlite
VAN_MT5_PULL_PORT=9443
VAN_PUBLIC_HOST=
