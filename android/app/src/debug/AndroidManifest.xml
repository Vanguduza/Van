<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Debug-only transport for the intentional 127.0.0.1/localhost fallback in
         VanGatewayClient. Release builds remain HTTPS-only and never merge this manifest. -->
    <application android:usesCleartextTraffic="true">
        <activity
            android:name=".visual.RiveCandidateHostActivity"
            android:exported="false"
            android:label="VAN Rive candidate"
            android:theme="@style/Theme.Van" />
        <!-- Owner test of a third-party VRM model in place of VAN (2026-09-25). Debug only:
             the provider registers the renderer, so a release build never has one. -->
        <provider
            android:name=".visual.VrmTestInitProvider"
            android:authorities="${applicationId}.vrmtest"
            android:exported="false" />
        <activity
            android:name=".visual.VrmTestModelActivity"
            android:exported="false"
            android:label="VAN test model"
            android:theme="@style/Theme.Van" />
    </application>
</manifest>
