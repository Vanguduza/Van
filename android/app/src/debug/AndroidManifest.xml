<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Debug-only transport for the intentional 127.0.0.1/localhost fallback in
         VanGatewayClient. Release builds remain HTTPS-only and never merge this manifest. -->
    <application android:usesCleartextTraffic="true">
        <activity
            android:name=".visual.RiveCandidateHostActivity"
            android:exported="true"
            android:label="VAN Character Rig Lab"
            android:theme="@style/Theme.Van">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
