<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!--
      P1-VOICE-001 — the wake listener holds the microphone, so its foreground service is
      typed `microphone`, not `specialUse`. The overlay's service stays `specialUse` because
      it draws; they are two services because they are two jobs, and typing a microphone
      service as special-use is how an app loses microphone access on Android 14 while
      believing it has it.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- P1-AND-014: ConnectivityManager.registerNetworkCallback needs this, and the
         offline queue's replay-on-recovery (P3-AND-006) is built on that callback.
         Without it the registration throws SecurityException, which the caller was
         swallowing, so the queue never drained when the network came back and
         nothing said why. A normal permission: granted at install, never prompted. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:name=".VanApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Van">

        <activity
            android:name=".onboarding.OnboardingActivity"
            android:exported="true"
            android:theme="@style/Theme.Van">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Rev 1.5 ADR-RB-026 — the installer's way in, started over ADB and never by the
          owner.

          `exported="true"` with no intent filter, so it is reachable by an explicit
          component name and does not appear anywhere. It usually would not be acceptable
          to export a component that provisions a device; it is here because the entry
          point holds no authority. The payload must be signed by a key compiled into this
          build, must not have expired, must not have been used before, and even then only
          earns two single-use tokens whose value depends on a hardware attestation the
          caller cannot produce (§0D.3). The signature is the guard; exportedness is only
          the channel.

          `noHistory` and `excludeFromRecents` because there is no screen and nothing for
          the owner to return to — §0D.2's point is that they are not part of this.
        -->
        <activity
            android:name=".provisioning.ProvisioningActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.NoDisplay" />

        <!--
          DNA §4 — the `van://<route>` deep links `CommandCentreActivity.onCreate`/
          `onNewIntent` resolve through `VanNavModel.deepLink`, never a raw path handed
          straight to the NavHost. `singleTop` because the Activity is meant to stay
          resident; `onNewIntent` reopens as a fresh task rather than threading a second
          route into an already-composed `NavHostController` (see that method's comment).
        -->
        <activity
            android:name=".command.CommandCentreActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Van">
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="van" />
            </intent-filter>
        </activity>

        <!--
          Rev 1.5 §7 — the owner holding a browser that runs somewhere else.

          `exported="false"`: nothing outside VAN may open a session on the owner's
          profile, and an exported activity taking a session id in an extra would be
          exactly that. `configChanges` for orientation and size because a recreate would
          tear down the WebRTC peer and the session behind it for what is a resize —
          §8.6's viewport revision handles the layout change without losing the stream.
        -->
        <activity
            android:name=".browser.BrowserActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:label="@string/browser_activity_label"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density"
            android:launchMode="singleTop"
            android:resizeableActivity="true"
            android:supportsPictureInPicture="false"
            android:theme="@style/Theme.Van" />

        <!--
            Rev 1.5 §17.5 — an http/https link another app handed to VAN.

            Exported, because the whole point is that other apps can reach it, and
            separate from BrowserActivity for exactly that reason: the activity the owner
            opens from inside VAN and the one a messaging app can start are different
            trust positions, and one activity serving both would mean an external intent
            arriving at the surface that already holds a session.

            BrowserExternalLink decides what happens next, and its answer is always the
            same shape: open it untrusted, in the public profile, with no Mission.
        -->
        <activity
            android:name=".browser.BrowserExternalLinkActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:label="@string/browser_activity_label"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
            </intent-filter>
        </activity>

        <!--
            ADR-RB-023 — the target of a pinned home-screen shortcut.

            It receives an opaque shortcut_id and nothing else. Not exported: a launcher
            starts it through the explicit component in the shortcut VAN created, and an
            exported one would let any app open the owner's saved pages by guessing ids.
        -->
        <activity
            android:name=".browser.BrowserShortcutActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:label="@string/browser_activity_label"
            android:theme="@android:style/Theme.NoDisplay" />

        <activity
            android:name=".trading.TradingCommandCentreActivity"
            android:exported="false"
            android:label="Van Trading"
            android:theme="@style/Theme.Van" />

        <service
            android:name=".overlay.FloatingOverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="van_owner_assistant_overlay" />
        </service>

        <service
            android:name=".voice.WakeListenerService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <service
            android:name=".notification.VanNotificationListenerService"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <receiver
            android:name=".overlay.OverlayRecoveryReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!--
          P1-AND-001 — the share sheet resolves activities, so this is an activity. It was a
          BroadcastReceiver carrying these same filters, which meant VAN never appeared in
          the share sheet at all and nothing anywhere reported the absence.
        -->
        <activity
            android:name=".share.ShareIntakeActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:label="@string/share_intake_label"
            android:taskAffinity=""
            android:theme="@style/Theme.Van.Transparent">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/*" />
                <data android:mimeType="image/*" />
                <data android:mimeType="application/*" />
                <data android:mimeType="audio/*" />
                <data android:mimeType="video/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="text/*" />
                <data android:mimeType="application/*" />
            </intent-filter>
        </activity>

    </application>
</manifest>
