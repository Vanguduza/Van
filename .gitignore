# Byte-compiled / cache
__pycache__/
*.py[cod]
.venv/
.venv-*/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Android / Gradle
android/.gradle/
android/**/build/
android/local.properties
keystore.properties
*.jks
van-release.jks
android/**/*.iml
android/.idea/
*.apk
*.aab
*.ap_
*.dex

# Secrets / local
.env
.env.*
!.env.example
*.pem
*.p12
keystore.properties
*.jks
google-oauth-client.json
gemini.env

# OS / IDE
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Release scratch
dist/
artifacts/local/
*.log

# Scratch extraction of the owner image pack; the boards are committed under
# visual-authority/assets/pack/ instead.
.tmp_vanpack/

# Keep release manifests; ignore bulky local APK copies
artifacts/release/*.apk
artifacts/release/*.aab
artifacts/google/*.sqlite3
artifacts/google/*.sqlite3-*

# Node (tooling)
node_modules/

# android/verification is a source-only Gradle harness; its build output is not evidence.
android/verification/.gradle/
android/verification/build/

# The preview renderer is a settings-only entry point onto :visual-preview; its Gradle
# working directory is not evidence and must not be committed.
android/preview-render/.gradle/

# The mutation harness writes this while a run is in progress; a run that finishes
# removes it, and a run that is killed leaves it for the next run to recover from.
tools/audit/.mutation-journal.json

# Kotlin compiler session directory, written by recent Gradle Kotlin plugins.
android/verification/.kotlin/

# Aura Rev 2 motion clips: CI evidence (van-visual-evidence artifact), not committed.
artifacts/release/preview/motion/
